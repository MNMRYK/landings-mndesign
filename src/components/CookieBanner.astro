---
// Lógica común del banner de cookies de las landings. El HTML y el CSS del banner son
// propios de cada landing (cada una con su estilo) y van justo antes de <CookieBanner />:
//   - contenedor #cookie-banner con style="display: none"
//   - botones #btn-accept-cookies y #btn-decline-cookies
//   - data-cookies-display (opcional): display con el que se muestra (por defecto "flex")
//   - data-cookies-ocultar (opcional): clases que animan la salida antes de ocultarlo
// Necesita CookiesHead.astro en el <head>. Cualquier enlace con el atributo
// data-configurar-cookies (el del footer) lo vuelve a abrir.
---

<script is:inline>
  (function () {
    var banner = document.getElementById("cookie-banner");
    if (!banner) return;

    var display = banner.getAttribute("data-cookies-display") || "flex";
    var clasesSalida = (banner.getAttribute("data-cookies-ocultar") || "").split(" ").filter(Boolean);
    var temporizador = null;

    function mostrar() {
      clearTimeout(temporizador);
      clasesSalida.forEach(function (c) {
        banner.classList.remove(c);
      });
      banner.style.display = display;
    }

    function ocultar() {
      if (!clasesSalida.length) {
        banner.style.display = "none";
        return;
      }
      clasesSalida.forEach(function (c) {
        banner.classList.add(c);
      });
      temporizador = setTimeout(function () {
        banner.style.display = "none";
      }, 500);
    }

    var decision = null;
    try {
      decision = localStorage.getItem("cookieConsent");
    } catch (e) {}
    if (!decision) mostrar();

    function elegir(valor) {
      try {
        localStorage.setItem("cookieConsent", valor);
      } catch (e) {}
      ocultar();

      if (valor === "accepted") {
        window.cargarTrackers();
      } else if (window.__trackersCargados) {
        // Había aceptado antes y los trackers ya están cargados: recargamos para pararlos
        location.reload();
      }
    }

    var aceptar = document.getElementById("btn-accept-cookies");
    var rechazar = document.getElementById("btn-decline-cookies");
    if (aceptar)
      aceptar.addEventListener("click", function () {
        elegir("accepted");
      });
    if (rechazar)
      rechazar.addEventListener("click", function () {
        elegir("declined");
      });

    // "Configurar cookies" del footer: vuelve a mostrar el banner
    document.addEventListener("click", function (e) {
      var enlace = e.target.closest && e.target.closest("[data-configurar-cookies]");
      if (!enlace) return;
      e.preventDefault();
      mostrar();
    });
  })();
</script>
