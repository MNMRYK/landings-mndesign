                ><svg class="i" viewBox="0 0 24 24" set:html={ic.play} /></span
              > Ver webs reales
            </a>
          </div>
          <p class="micro rv" style="--d:.3s">
            Sin compromiso · Te respondemos personalmente en menos de 24 h · 3-5
            semanas de idea a web
          </p>

