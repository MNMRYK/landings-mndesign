          class="burger"
          id="burger"
          type="button"
          aria-label="Abrir menú"
          aria-controls="mnav"
          aria-expanded="false"
        >
          <span></span><span></span><span></span>
        </button>
      </div>

      <!-- Panel de menú móvil: capa fija a pantalla completa -->
      <nav class="mnav" id="mnav" aria-label="Menú móvil">
        <div class="mnav-head">
          <a class="logo" href="#"><i>MN</i><span>Design Web</span></a>
          <button
            class="mnav-close"
            id="mnav-close"
            type="button"
            aria-label="Cerrar menú"
          >
