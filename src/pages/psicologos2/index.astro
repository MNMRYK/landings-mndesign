// SEO: título y descripciones compartidos por <title>, Open Graph, Twitter y Schema
const pageUrl = "https://mndesignweb.es/psicologos/";
const seoTitle = "Software y Web para Psicólogos a Medida | MN Design Web";
const seoDescription =
  "Tu web de psicólogo con software propio de gestión de pacientes: agenda online, terapia online cifrada y cobros. Sin cuotas a terceros y con RGPD incluido.";
const socialDescription =
  "Web para psicólogos y clínicas de psicología con tu propia plataforma de pacientes a medida: agenda, recordatorios, cobros y videoconsulta cifrada sin pagar cuotas a terceros.";

// Schema.org (JSON-LD). Se genera con JSON.stringify para que siempre sea válido
// y las FAQ coincidan exactamente con las que se ven en la página.
const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": `${pageUrl}#webpage`,
      url: pageUrl,
      name: seoTitle,
      description: seoDescription,
      inLanguage: "es-ES",
      about: { "@id": `${pageUrl}#servicio` },
    },
    {
      "@type": "ProfessionalService",
      "@id": "https://mndesignweb.es/#empresa",
      name: "MN Design Web",
      image: "https://mndesignweb.es/logo.webp",
