<html lang="es">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>MN Design Web | Enlaces</title>
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
		<meta name="apple-mobile-web-app-status-bar-style" content="default" />
		<link rel="canonical" href="https://mndesignweb.es/enlaces/" />
		<link rel="icon" type="image/webp" href="/favicon_v2.webp" />
		<meta name="robots" content="noindex, nofollow">
	</head>
	<body>
		<main class="link-container">
			<!-- Cabecera / Perfil -->
			<div class="profile-header">
				<div class="logo-wrapper">
					<!-- Asegúrate de tener tu logo en public o cámbialo por SVG -->
					<img src="/favicon_v2.webp" alt="MN Design Web Logo" class="logo" />
				</div>
				<h1>MN Design Web</h1>
				<p>Desarrollo a medida | E-commerce | Software</p>
			</div>

			<!-- Bloque 1: Llamadas a la acción principales -->
			<div class="links-group">
				<a href="https://cal.com/mndesignweb/reunion-30-min" class="btn btn-primary">
					<!-- Icono Calendario -->
					<svg class="btn-icon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
					Agenda tu Auditoría Gratuita
				</a>
				<a href="https://mndesignweb.es/" class="btn btn-secondary">
					Visita nuestra Web
				</a>
			</div>

			<!-- Bloque 2: Ataque directo al nicho (Salud) -->
			<div class="links-group">
				<a href="/clinicas/" class="btn btn-subtle">Software Consulta Clínica</a>
				<a href="/nutricionistas/" class="btn btn-subtle">Webs para Nutricionistas</a>
				<a href="/psicologos/" class="btn btn-subtle">Webs para Psicólogos</a>
			</div>

			<!-- Bloque 3: E-commerce -->
			<div class="links-group">
				<a href="/aprende-shopify/" class="btn btn-dark">
					<!-- Icono Bolsa Shopify -->
					<svg class="btn-icon shopify-icon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path><line x1="3" y1="6" x2="21" y2="6"></line><path d="M16 10a4 4 0 0 1-8 0"></path></svg>
					Mentorías Shopify
				</a>
			</div>

			<!-- Bloque 4: Redes Sociales con Iconos -->
			<footer class="social-footer">
				<a href="https://www.linkedin.com/in/mar%C3%ADa-nadal-masi%C3%A1-080a77315/" target="_blank" rel="noopener" aria-label="LinkedIn">
					<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path><rect x="2" y="9" width="4" height="12"></rect><circle cx="4" cy="4" r="2"></circle></svg>
				</a>
				<a href="https://github.com/MNMRYK" target="_blank" rel="noopener" aria-label="GitHub">
					<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path></svg>
				</a>
				<a href="https://www.instagram.com/mndesignweb/" target="_blank" rel="noopener" aria-label="Instagram">
					<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg>
				</a>
			</footer>
		</main>
	</body>
</html>

<style>
	* {
		box-sizing: border-box;
		margin: 0;
		padding: 0;
	}

	body {
		font-family: 'Poppins', sans-serif;
		background: linear-gradient(135deg, #0f172a 0%, #1e1b4b 100%);
		color: #1e293b;
		min-height: 100vh;
		display: flex;
		justify-content: center;
		align-items: center;
		padding: 30px !important;
	}

	.link-container {
		width: 100%;
		max-width: 420px;
		background: #ffffff;
		border-radius: 24px;
		padding: 30px 30px;
		box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3);
		display: flex;
		flex-direction: column;
		gap: 28px;
	}

	.profile-header {
		text-align: center;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 6px;
	}

	.logo-wrapper {
		width: 80px;
		height: 80px;
		background: linear-gradient(135deg, #8a31da 0%, #7729bb 100%);
		border-radius: 50%;
		display: flex;
		justify-content: center;
		align-items: center;
		box-shadow: 0 6px 12px rgba(139, 92, 246, 0.3);
	}

	.logo {
		width: 72px;
		height: 72px;
		object-fit: contain;
	}

	h1 {
		font-size: 1.25rem;
		font-weight: 700;
		color: #0f172a;
	}

	.profile-header p {
		font-size: 0.8rem;
		color: #64748b;
		font-weight: 500;
	}

	.links-group {
		display: flex;
		flex-direction: column;
		gap: 8px;
		width: 100%;
	}

	.btn {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 8px;
		width: 100%;
		padding: 11px 16px;
		text-align: center;
		text-decoration: none;
		border-radius: 50px;
		font-size: 0.9rem;
		font-weight: 600;
		transition: all 0.25s ease;
	}

	.btn:hover {
		transform: translateY(-2px);
		box-shadow: 0 4px 10px rgba(0, 0, 0, 0.08);
	}

	.btn-primary {
		background: linear-gradient(135deg, #8a31da 0%, #7729bb 100%);
		color: #ffffff;
		box-shadow: 0 6px 15px rgba(122, 41, 187, 0.3);
	}

	.btn-secondary {
		background: #ffffff;
		color: #7729bb;
		border: 2px solid #8a31da;
	}

	.btn-secondary:hover {
		background: #f5f3ff;
	}

	.btn-subtle {
		background: #f1f5f9;
		color: #334155;
		font-weight: 500;
		padding: 10px 16px; /* Ligeramente más compacto */
	}

	.btn-subtle:hover {
		background: #e2e8f0;
		color: #0f172a;
	}

	.btn-dark {
		background: #0f172a;
		color: #ffffff;
	}

	.btn-dark:hover {
		background: #1e293b;
	}

	.btn-icon {
		stroke: currentColor;
	}

	.shopify-icon {
		stroke: #d946ef; /* Tonalidad rosa/morada para la bolsa de shopify */
	}

	.social-footer {
		display: flex;
		justify-content: center;
		gap: 24px;
		margin-top: 4px;
		padding-top: 10px;
		border-top: 1px solid #f1f5f9;
	}

	.social-footer a {
		color: #94a3b8;
		transition: color 0.2s ease;
		display: flex;
		align-items: center;
	}

	.social-footer a:hover {
		color: #8a31da;
	}


</style>