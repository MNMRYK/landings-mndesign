      <!-- 4. Negocios de la zona -->
      <section class="bloque" aria-labelledby="t-zona">
        <h2 id="t-zona" class="entra" style={paso()}>Para negocios de la zona</h2>
        <div class="rejilla">
          {
            zona.map((t) => (
              <a class="tarjeta entra" style={paso()} href={t.href} data-destino={t.destino}>
                <span class="icono" set:html={icon(t.icono)} />
                {t.etiqueta && <span class="etiqueta" lang={t.lang}>{t.etiqueta}</span>}
                <span class="t-titulo">{t.titulo}</span>
                <span class="t-texto">{t.texto}</span>
              </a>
            ))
          }
