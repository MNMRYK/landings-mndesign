    </main>

    <div
      id="cookie-banner"
      class="cookie-banner"
      style="display: none"
      role="dialog"
      aria-labelledby="cookie-title"
      aria-describedby="cookie-desc"
    >
      <div class="cookie-txt">
        <p class="cookie-title" id="cookie-title">Usamos cookies</p>
        <p class="cookie-desc" id="cookie-desc">
          Usamos cookies propias y de terceros para medir las visitas y mostrarte publicidad personalizada. Puedes
          aceptarlas, rechazarlas o configurarlas.
          <span class="cc-enlaces"><a href="https://mndesignweb.es/cookies/">Ver política de cookies</a> <button type="button" class="cc-link" data-configurar-cookies>Configurar</button></span>
        </p>
      </div>
      <div class="cookie-actions">
        <button id="btn-decline-cookies" type="button" class="cookie-btn cookie-btn-ghost">Rechazar</button>
        <button id="btn-accept-cookies" type="button" class="cookie-btn cookie-btn-main">Aceptar</button>
      </div>
    </div>
    <CookieBanner />

    <script is:inline define:vars={{ CAL_LINK: "mndesignweb/reunion-30-min" }}>
      // click_enlace en cada enlace (los de WhatsApp y cal.com envían además click_whatsapp / click_reserva
      // desde CookiesHead). enviarEvento solo envía si el usuario ha aceptado las cookies.
      document.addEventListener("click", function (e) {
        var a = e.target.closest && e.target.closest("a[data-destino]");
        if (a && window.enviarEvento) window.enviarEvento("click_enlace", { destino: a.getAttribute("data-destino") });
      });

      // "Llamada gratis": calendario de Cal.com en ventana emergente (el embed solo se descarga al pulsar).
      // book_call y Schedule se envían cuando la reserva se completa, no al pulsar.
      // Si el embed no carga, el enlace abre cal.com como siempre.
      var calBtn = document.querySelector("[data-cal]");
      var reservado = false;
      function onBooked() {
        if (reservado) return;
        reservado = true;
        window.enviarEvento && window.enviarEvento("book_call", { method: "cal_com", calendario: "enlaces" });
        window.enviarMeta && window.enviarMeta("Schedule");
      }
      function cargarCal() {
        (function (C, A, L) {
          var p = function (a, ar) { a.q.push(ar); };
          var d = C.document;
          C.Cal = C.Cal || function () {
            var cal = C.Cal, ar = arguments;
            if (!cal.loaded) {
              cal.ns = {}; cal.q = cal.q || [];
              var s = d.head.appendChild(d.createElement("script"));
              s.src = A;
              s.onerror = function () { window.open(calBtn.href, "_blank", "noopener"); };
              cal.loaded = true;
            }
            if (ar[0] === L) {
              var api = function () { p(api, arguments); };
              var namespace = ar[1];
              api.q = api.q || [];
              if (typeof namespace === "string") {
                cal.ns[namespace] = cal.ns[namespace] || api;
                p(cal.ns[namespace], ar);
                p(cal, ["initNamespace", namespace]);
              } else p(cal, ar);
              return;
            }
            p(cal, ar);
          };
        })(window, "https://app.cal.com/embed/embed.js", "init");
        Cal("init", "enlaces", { origin: "https://cal.com" });
        Cal.ns.enlaces("ui", { hideEventTypeDetails: false, layout: "month_view" });
        Cal.ns.enlaces("on", { action: "bookingSuccessfulV2", callback: onBooked });
        Cal.ns.enlaces("on", { action: "bookingSuccessful", callback: onBooked });
      }
      if (calBtn) {
        calBtn.addEventListener("click", function (e) {
          e.preventDefault();
          if (!window.Cal || !window.Cal.ns || !window.Cal.ns.enlaces) cargarCal();
          window.Cal.ns.enlaces("modal", { calLink: CAL_LINK, config: { layout: "month_view" } });
        });
      }
    </script>
  </body>
</html>

