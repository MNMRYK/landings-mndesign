      </section>

      <!-- 6. Destacada -->
      <a class="destacada entra" style={paso()} href="/aprende-shopify/" data-destino="aprende-shopify">
        <span class="icono icono-claro" set:html={icon(ShoppingBag)} />
        <span class="d-textos">
          <span class="t-titulo">Mentorías Shopify</span>
          <span class="t-texto">Toma el control de tu tienda, 1&nbsp;a&nbsp;1</span>
        </span>
        <Fragment set:html={icon(ArrowRight, "ico flecha")} />
      </a>

      <!-- 7. Redes y pie -->
      <footer class="pie entra" style={paso()}>
        <nav class="redes" aria-label="Redes sociales">
          <a href="https://www.linkedin.com/in/mar%C3%ADa-nadal-masi%C3%A1-080a77315/" target="_blank" rel="noopener" aria-label="LinkedIn" data-destino="linkedin">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path><rect x="2" y="9" width="4" height="12"></rect><circle cx="4" cy="4" r="2"></circle></svg>
          </a>
          <a href="https://github.com/MNMRYK" target="_blank" rel="noopener" aria-label="GitHub" data-destino="github">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path></svg>
          </a>
          <a href="https://www.instagram.com/mndesignweb/" target="_blank" rel="noopener" aria-label="Instagram" data-destino="instagram">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg>
          </a>
        </nav>
