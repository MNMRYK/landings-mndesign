      </section>

      <!-- 5. Profesionales de la salud -->
      <section class="bloque" aria-labelledby="t-salud">
        <h2 id="t-salud" class="entra" style={paso()}>Para profesionales de la salud</h2>
        <div class="rejilla">
          {
            salud.map((t) => (
              <a class="tarjeta entra" style={paso()} href={t.href} data-destino={t.destino}>
                <span class="icono" set:html={icon(t.icono)} />
                <span class="t-titulo">{t.titulo}</span>
                <span class="t-texto">{t.texto}</span>
