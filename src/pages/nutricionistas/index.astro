---
import CookiesHead from "../../components/CookiesHead.astro";
import CookieBanner from "../../components/CookieBanner.astro";
import "./style.css";

// FAQ: una sola fuente para el HTML visible y para el Schema (deben coincidir)
const faqs = [
  [
    "¿En qué os diferenciáis de una agencia de diseño web tradicional?",
    "Las agencias generalistas hacen webs bonitas; yo diseño ecosistemas de salud. Entiendo cómo funciona la normativa RGPD para datos médicos, qué necesita un software clínico (ERP) para sincronizarse y cómo debe fluir un paciente para reservar sin fricción. Hablamos tu mismo idioma desde el minuto uno.",
  ],
  [
    "¿Tendré que pagar cuotas ocultas o depender de ti para cada cambio?",
    "Cero secuestros digitales. La web y la infraestructura son 100% tuyas. Te entrego el proyecto \"llave en mano\" con videotutoriales grabados sobre tu propia plataforma para que tú y tu equipo podáis modificar textos, subir dietas o gestionar agendas con total autonomía.",
  ],
  [
    "He tenido malas experiencias con plazos, ¿cuánto tardaremos en lanzar?",
    "Trabajo con metodologías ágiles y fechas bloqueadas por contrato. Una Fase 1 (Web y Agenda) suele estar lista en 3-4 semanas desde que recibimos tu material. Si optamos por el Ecosistema Total, el cronograma es de 6 a 8 semanas. Sin retrasos, sorpresas ni excusas.",
  ],
  [
    "Mis pacientes no son muy tecnológicos, ¿les costará usar el portal?",
    "Diseño pensando en la \"paciencia cero\" del usuario. La interfaz móvil de reservas y el portal del paciente están creados con la máxima usabilidad (UX/UI). Si tus pacientes saben enviar un mensaje por WhatsApp, sabrán entrar a su videoconsulta, descargar su dieta o pagar su suscripción en un par de clics.",
  ],
  [
    "¿Qué pasa si la web se cae o tengo un problema tras el lanzamiento?",
    "No te dejo sola frente a una pantalla en blanco. Ofrezco planes opcionales de soporte y mantenimiento técnico donde me encargo de las actualizaciones, seguridad y resolución de incidencias. Tu único trabajo es pasar consulta; del código y los servidores me encargo yo.",
  ],
];

// Schema.org (JSON-LD) en un único bloque, generado para que siempre sea válido
const pageUrl = "https://mndesignweb.es/nutricionistas/";
const seoTitle = "Diseño Web para Nutricionistas y Dietistas | MN Design Web";
const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": `${pageUrl}#webpage`,
      url: pageUrl,
      name: seoTitle,
      description:
        "Desarrollo web a medida para nutricionistas y dietistas. Centraliza reservas, expedientes y venta de cursos en tu propio dominio sin plataformas externas.",
      inLanguage: "es-ES",
      about: { "@id": `${pageUrl}#servicio` },
      breadcrumb: { "@id": `${pageUrl}#breadcrumb` },
    },
    {
      "@type": "ProfessionalService",
      "@id": "https://mndesignweb.es/#empresa",
      name: "MN Design Web",
      image: "https://mndesignweb.es/logo.webp",
      url: "https://mndesignweb.es/",
      telephone: "+34645854934",
      email: "info@mndesignweb.es",
      address: {
        "@type": "PostalAddress",
        streetAddress: "Passeig del Comtat, 75, 5º 1º",
        postalCode: "03820",
        addressLocality: "Cocentaina",
        addressRegion: "Alicante",
        addressCountry: "ES",
      },
      priceRange: "$$",
    },
    {
      "@type": "Service",
      "@id": `${pageUrl}#servicio`,
      name: "Digitalización de Consultas de Nutrición",
      image: "https://mndesignweb.es/nutri/imagen-miniatura-nutricion.webp",
      description:
        "Construcción de ecosistemas digitales completos en WordPress: diseño web estratégico, software de reservas, portal del paciente y academia online 100% en propiedad.",
      provider: { "@id": "https://mndesignweb.es/#empresa" },
      audience: {
        "@type": "Audience",
        audienceType: "Nutricionistas, dietistas y clínicas de nutrición",
      },
    },
    {
      "@type": "FAQPage",
      "@id": `${pageUrl}#faq`,
      mainEntity: faqs.map(([q, a]) => ({
        "@type": "Question",
        name: q,
        acceptedAnswer: { "@type": "Answer", text: a },
      })),
    },
    {
      "@type": "BreadcrumbList",
      "@id": `${pageUrl}#breadcrumb`,
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Inicio MN Design Web",
          item: "https://mndesignweb.es/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Diseño Web para Nutricionistas",
          item: pageUrl,
        },
      ],
    },
  ],
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Diseño Web para Nutricionistas y Dietistas | MN Design Web</title>

    <meta
      name="description"
      content="Digitaliza tu consulta de nutrición. Desarrollo web a medida con reservas, portal del paciente y academia online 100% integrados en tu propio dominio."
    />
    <meta name="author" content="MN Design Web" />

    <meta
      name="theme-color"
      media="(prefers-color-scheme: light)"
      content="#667055"
    />
    <meta
      name="theme-color"
      media="(prefers-color-scheme: dark)"
      content="#667055"
    />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />

    <link rel="canonical" href="https://mndesignweb.es/nutricionistas/" />
    <link rel="icon" type="image/webp" href="/favicon_v2.webp" />
    <meta name="robots" content="index, follow" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap"
      rel="stylesheet"
    />

    <link
      rel="preload"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
      as="style"
      onload="
        this.onload = null;
        this.rel = 'stylesheet';
