---
import "./style.css";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- TÍTULO OPTIMIZADO (62 caracteres - Perfecto para Google) -->
    <title>Diseño Web para Nutricionistas y Dietistas | MN Design Web</title>

    <meta
      name="description"
      content="Digitaliza tu consulta de nutrición. Desarrollo web a medida con reservas, portal del paciente y academia online 100% integrados en tu propio dominio."
    />
    <meta name="author" content="MN Design Web" />

    <meta
      name="theme-color"
      media="(prefers-color-scheme: light)"
      content="#667055"
    />
    <meta
      name="theme-color"
      media="(prefers-color-scheme: dark)"
      content="#667055"
    />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />

    <link
      rel="canonical"
      href="https://mndesignweb.es/nutricionistas"
    />
    <link rel="icon" type="image/webp" href="/favicon_v2.webp" />
    <meta name="robots" content="index, follow" />

    <!-- PRECARGA DE FUENTES Y ESTILOS -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap"
      rel="stylesheet"
    />

    <link
      rel="preload"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
      as="style"
      onload="
        this.onload = null;
        this.rel = 'stylesheet';
      "
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
      />
    </noscript>

    <!-- OPEN GRAPH (Redes Sociales y WhatsApp) -->
    <meta property="og:type" content="website" />
    <meta
      property="og:url"
      content="https://mndesignweb.es/nutricionistas"
    />
    <meta
      property="og:title"
      content="Diseño Web para Nutricionistas y Dietistas | MN Design Web"
    />
    <meta
      property="og:description"
      content="Centraliza tu consulta. Diseño web, agenda automática y portal del paciente integrados en tu propio dominio. Deja de pagar a plataformas de terceros."
    />
    <meta
      property="og:image"
      content="https://mndesignweb.es/imagen-miniatura-nutricion.webp"
    />
    <meta property="og:locale" content="es_ES" />

    <!-- TWITTER CARDS -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta
      name="twitter:url"
      content="https://mndesignweb.es/nutricionistas"
    />
    <meta
      name="twitter:title"
      content="Diseño Web para Nutricionistas y Dietistas | MN Design Web"
    />
    <meta
      name="twitter:description"
      content="Centraliza tu consulta. Diseño web, agenda automática y portal del paciente integrados en tu propio dominio."
    />
    <meta
      name="twitter:image"
      content="https://mndesignweb.es/nutri/imagen-miniatura-nutricion.webp"
    />

    <!-- DATOS ESTRUCTURADOS (JSON-LD) -->
    <script type="application/ld+json">
      [
        {
          "@context": "https://schema.org",
          "@type": "WebPage",
          "name": "Diseño Web para Nutricionistas y Dietistas | MN Design Web",
          "description": "Desarrollo web a medida para nutricionistas y dietistas. Centraliza reservas, expedientes y venta de cursos en tu propio dominio."
        },
        {
          "@context": "https://schema.org",
          "@type": "ProfessionalService",
          "name": "MN Design Web",
          "image": "https://mndesignweb.es/nutri/logo.webp",
          "url": "https://mndesignweb.es/",
          "address": {
            "@type": "PostalAddress",
            "streetAddress": "Avenida Passeig del Comtat n75",
            "addressLocality": "Cocentaina",
            "addressRegion": "Alicante",
            "postalCode": "03820",
            "addressCountry": "ES"
          },
          "priceRange": "$$$"
        },
        {
          "@context": "https://schema.org/",
          "@type": "Service",
          "name": "Digitalización de Consultas de Nutrición",
          "image": "https://mndesignweb.es/nutri/imagen-miniatura-nutricion.webp",
          "description": "Ecosistemas digitales completos en WordPress: diseño web estratégico, software de reservas, portal del paciente y academia online."
        },
        {
          "@context": "https://schema.org",
          "@type": "FAQPage",
          "mainEntity": [
            {
              "@type": "Question",
              "name": "¿En qué os diferenciáis de una agencia de diseño web tradicional?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Las agencias generalistas hacen webs bonitas; yo diseño ecosistemas de salud. Entiendo la normativa RGPD para datos médicos y cómo debe fluir un paciente para reservar sin fricción."
              }
            },
            {
              "@type": "Question",
              "name": "¿Tendré que pagar cuotas ocultas o depender de ti para cada cambio?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Cero secuestros digitales. La web y la infraestructura son 100% tuyas, en tu propio dominio. Te entrego el proyecto llave en mano con videotutoriales."
              }
            },
            {
              "@type": "Question",
              "name": "He tenido malas experiencias con plazos, ¿cuánto tardaremos en lanzar?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Una Fase 1 (Web y Agenda) suele estar lista en 3-4 semanas. Si optamos por el Ecosistema Total, el cronograma es de 6 a 8 semanas con fechas bloqueadas por contrato."
              }
            },
            {
              "@type": "Question",
              "name": "Mis pacientes no son muy tecnológicos, ¿les costará usar el portal?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "La interfaz móvil de reservas y el portal privado están creados con la máxima usabilidad. Si saben usar WhatsApp, sabrán descargar su dieta."
              }
            },
            {
              "@type": "Question",
              "name": "¿Qué pasa si la web se cae o tengo un problema tras el lanzamiento?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Ofrezco planes opcionales de soporte y mantenimiento técnico donde me encargo de las actualizaciones, seguridad y resolución de incidencias."
              }
            }
          ]
        },
        {
          "@context": "https://schema.org",
          "@type": "BreadcrumbList",
          "itemListElement": [
            {
              "@type": "ListItem",
              "position": 1,
              "name": "Inicio MN Design Web",
              "item": "https://mndesignweb.es/"
            },
            {
              "@type": "ListItem",
              "position": 2,
              "name": "Diseño Web para Nutricionistas",
              "item": "https://mndesignweb.es/nutricionistas"
            }
          ]
        }
      ]
    </script>

