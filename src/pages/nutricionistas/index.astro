      property="og:image"
      content="https://mndesignweb.es/nutri/imagen-miniatura-nutricion.webp"
    />
    <meta property="og:locale" content="es_ES" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content="https://mndesignweb.es/nutricionistas/" />
    <meta
      name="twitter:title"
      content="Diseño Web para Nutricionistas y Dietistas | MN Design Web"
    />
    <meta
      name="twitter:description"
      content="Centraliza tu consulta. Diseño web, agenda automática y portal del paciente integrados en tu propio dominio."
    />
    <meta
      name="twitter:image"
      content="https://mndesignweb.es/nutri/imagen-miniatura-nutricion.webp"
    />

    <!-- Schema.org: un único bloque generado desde el frontmatter -->
    <script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />

    <CookiesHead />
  </head>
  <body>
    <header class="navbar">
      <div class="navbar-container">
        <a href="#" class="navbar-logo">MN Design <span>Web</span></a>

        <nav class="desktop-nav">
          <a href="#web-inicial" class="mobile-link">Diseño Web</a>
          <a href="#Consulta" class="mobile-link">Consultas</a>
          <a href="#modulos" class="mobile-link">Módulos</a>
          <a href="#inversion" class="mobile-link">Inversión</a>
        </nav>

        <div class="desktop-cta-container">
          <a href="#agendar-consultoria" class="navbar-cta"
            >Agendar consultoría</a
          >
        </div>

        <button
          id="mobile-menu-btn"
          class="menu-toggle"
          aria-label="Abrir menú"
        >
          <svg
            viewBox="0 0 24 24"
            width="24"
            height="24"
            stroke="currentColor"
            stroke-width="2"
            fill="none"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <line x1="3" y1="12" x2="21" y2="12"></line>
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <line x1="3" y1="18" x2="21" y2="18"></line>
          </svg>
        </button>
      </div>

      <div id="mobile-dropdown" class="mobile-dropdown">
        <a href="#web-inicial" class="mobile-link">Diseño Web</a>
        <a href="#Consulta" class="mobile-link">Consultas</a>
        <a href="#modulos" class="mobile-link">Módulos</a>
        <a href="#inversion" class="mobile-link">Inversión</a>

        <a href="#agendar-consultoria" class="mobile-cta-btn"
          >Agendar consultoría</a
        >
      </div>
    </header>

    <main>
      <section class="hero">
        <div class="hero-content">
          <span class="hero-tag">Desarrollo Web High Ticket</span>
          <h1>
            Digitaliza la gestión de tu consulta de <span>nutrición</span>
          </h1>
          <p>
            Una infraestructura web corporativa que trabaja por ti. Automatiza
            reservas, cobra online y centraliza el seguimiento en tu propio
            Portal del Paciente.
          </p>
          <a href="#agendar-consultoria" class="cta-button"
            >Ver disponibilidad en la agenda</a
          >
        </div>
        <div class="hero-visual">
          <div class="phone-mockup">
            <div class="phone-notch"></div>
            <div class="phone-screen">
              <img
                src="/nutri/movil.webp"
                alt="Vista móvil del portal del paciente"
                class="mockup-img-phone"
              />
            </div>
          </div>

          <div class="laptop-mockup">
            <div class="ui-header">
              <div class="ui-dot"></div>
              <div class="ui-dot"></div>
              <div class="ui-dot"></div>
            </div>
            <div class="ui-body">
              <img
                src="/nutri/pc.webp"
                alt="Vista escritorio de la plataforma de nutrición"
                class="mockup-img-pc"
              />
            </div>
            <div class="laptop-base"></div>
          </div>
        </div>
      </section>

      <section class="features">
        <div class="features-header reveal">
          <h2 class="features-title" id="Consulta">
            Tu consulta, centralizada y en piloto automático
          </h2>
          <p class="features-subtitle">
            Olvídate de usar 4 herramientas distintas. Integramos reservas,
            gestión de pacientes y venta de cursos en una única plataforma
            corporativa.
          </p>
        </div>

        <div class="feature-row reveal" id="reservas">
          <div class="feature-text">
            <h3>Sistema de Reservas Automático</h3>
            <p>
              Deja de cuadrar agendas por WhatsApp. Tus pacientes seleccionan el
              día, la hora y pagan la consulta directamente desde tu web,
              sincronizado con tu calendario.
            </p>
            <ul class="feature-list">
              <li>Sincronización bidireccional en tiempo real</li>
              <li>Pasarela de pago segura (Stripe/Redsys)</li>
              <li>Recordatorios automáticos para reducir ausencias</li>
            </ul>
          </div>
          <div class="feature-visual">
            <div class="feature-mockup calendar-mockup">
              <div class="calendar-header">
                <span class="calendar-month">OCTUBRE 2026</span>
                <div class="calendar-dots">
                  <div class="calendar-dot dark"></div>
                  <div class="calendar-dot light"></div>
                </div>
              </div>
              <div class="calendar-layout">
                <div class="calendar-grid-container">
                  <div class="calendar-label">Selecciona el día</div>
                  <div class="calendar-grid">
                    <div class="calendar-day inactive"></div>
                    <div class="calendar-day inactive"></div>
                    <div class="calendar-day active">14</div>
                    <div class="calendar-day"></div>
                    <div class="calendar-day"></div>
                    <div class="calendar-day empty"></div>
                    <div class="calendar-day"></div>
                    <div class="calendar-day"></div>
                  </div>
                </div>
                <div class="calendar-time-container">
                  <div class="calendar-label">Hora disponible</div>
                  <div class="calendar-time-list">
                    <div class="calendar-time-slot">09:30 h</div>
                    <div class="calendar-time-slot active">11:00 h</div>
                    <div class="calendar-time-slot">16:30 h</div>
                  </div>
                </div>
              </div>
              <div class="calendar-footer">
                <span class="calendar-footer-text"
                  >Sincronizado con Google Calendar</span
                >
                <span class="calendar-footer-cta">Confirmar cita →</span>
              </div>
            </div>
          </div>
        </div>

        <div class="feature-row reverse reveal" id="portal">
          <div class="feature-text">
            <h3>Portal del Paciente Centralizado</h3>
            <p>
              Un área privada donde tus pacientes acceden con su usuario.
              Comparte planes nutricionales, pautas y permite que registren su
              evolución de forma segura.
            </p>
            <ul class="feature-list">
              <li>Entrega de dietas y recursos sin usar WhatsApp</li>
              <li>Gráficas de evolución de peso y medidas</li>
              <li>Historial clínico y documentos cifrados</li>
            </ul>
          </div>
          <div class="feature-visual">
            <div class="feature-mockup mockup-portal">
              <div class="portal-header">
                <div class="portal-nav-pills">
                  <div class="portal-pill active">Mi Evolución</div>
                  <div class="portal-pill">Dietas</div>
                  <div class="portal-pill">Mensajes</div>
                </div>
                <div class="portal-badge">Área Privada</div>
              </div>

              <div class="portal-user-row">
                <div class="portal-avatar">
                  MP
                  <div class="portal-status-dot"></div>
                </div>
                <div class="portal-user-details">
                  <div class="portal-user-name">María Pérez</div>
                  <div class="portal-user-goal">Objetivo: Pérdida de grasa</div>
                </div>
                <div class="portal-next-appointment">
                  <div
                    style="
                    font-size: 9px;
                    color: var(--text-muted);
                    text-transform: uppercase;
                    letter-spacing: 0.5px;
                    margin-bottom: 2px;
                  "
                  >
                    Próxima cita
                  </div>
                  <div
                    style="
                    font-size: 12px;
                    color: var(--primary);
                    font-weight: 800;
                  "
                  >
                    24 Oct - 16:30h
                  </div>
                </div>
              </div>

              <div class="portal-content-row">
                <div class="portal-chart-box">
                  <div class="portal-chart-title">Evolución de peso (kg)</div>

                  <div class="portal-grid-line" style="top: 35%"></div>
                  <div class="portal-grid-line" style="top: 60%"></div>
                  <div class="portal-grid-line" style="top: 85%"></div>

                  <svg
                    viewBox="-5 -5 110 55"
                    preserveAspectRatio="none"
                    class="portal-chart-svg"
                  >
                    <defs>
                      <linearGradient
                        id="chart-gradient"
                        x1="0%"
                        y1="0%"
                        x2="0%"
                        y2="100%"
                      >
                        <stop
                          offset="0%"
                          stop-color="var(--button-cta)"
                          stop-opacity="0.3"></stop>
                        <stop
                          offset="100%"
                          stop-color="var(--button-cta)"
                          stop-opacity="0"></stop>
                      </linearGradient>
                    </defs>
                    <path
                      d="M0,40 Q20,15 40,30 T80,15 T100,25 L100,50 L0,50 Z"
                      fill="url(#chart-gradient)"></path>
                    <path
                      d="M0,40 Q20,15 40,30 T80,15 T100,25"
                      fill="none"
                      stroke="var(--button-cta)"
                      stroke-width="2.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"></path>
                    <circle
                      cx="80"
                      cy="15"
                      r="3.5"
                      fill="white"
                      stroke="var(--button-cta)"
                      stroke-width="2.5"></circle>
                  </svg>
                </div>

                <div class="portal-files-col">
                  <div
                    class="portal-file-card"
                    style="background: var(--card-bg)"
                  >
                    <div class="file-icon" style="color: var(--button-cta)">
                      📄
                    </div>
                    <div class="file-info">
                      <span class="file-name" style="color: white"
                        >Dieta_Semana4.pdf</span
                      >
                      <span
                        class="file-size"
                        style="color: rgba(255, 255, 255, 0.8)">1.2 MB</span
                      >
                    </div>
                  </div>
                  <div
                    class="portal-file-card"
                    style="background: var(--accent)"
                  >
                    <div class="file-icon" style="color: var(--primary)">
                      📋
                    </div>
                    <div class="file-info">
                      <span class="file-name">Pautas_Suplementos</span>
                      <span class="file-size">Nuevo archivo</span>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="feature-row reveal" id="academia">
          <div class="feature-text">
            <span
              class="web-inicial-tag"
              style="color: var(--button-cta); margin-bottom: 8px"
              >Ingresos Pasivos y Escalabilidad</span
            >
            <h3>Escala tus ingresos con tu propia Academia Online</h3>
            <p>
              El techo de tu facturación son tus horas disponibles. Deja de
              depender exclusivamente de las consultas 1 a 1 y empaqueta tu
              conocimiento. Crea cursos, retos nutricionales o programas
              grupales y monetiza tu experiencia las 24 horas del día.
            </p>
            <ul class="feature-list">
              <li>
                <strong>Alojamiento integral 100% tuyo:</strong> Olvídate de pagar
                comisiones a plataformas externas (como Hotmart, Teachable o Vimeo).
                Todo vive en tu web.
              </li>
              <li>
                <strong>Membresías y pagos recurrentes:</strong> Configura cobros
                automáticos mensuales para generar ingresos predecibles de tu comunidad
                privada.
              </li>
              <li>
                <strong>Experiencia gamificada:</strong> Control de progreso visual,
                lecciones bloqueadas y certificados para que tus pacientes completen
                el programa.
              </li>
              <li>
                <strong>Protección de contenido:</strong> Material blindado y sistema
                anticopia, accesible única y exclusivamente para alumnos con suscripción
                activa.
              </li>
            </ul>
          </div>

          <div class="feature-visual">
            <div class="feature-mockup mockup-academia">
              <div class="academia-sidebar">
                <div class="academia-course-title">
                  Reto: Desinflamación 21 Días
                </div>
                <div class="academia-module">
                  <div class="academia-module-icon done">✓</div>
                  <div class="academia-module-text">
                    Módulo 1: Bases y compras
                  </div>
                </div>
                <div class="academia-module">
                  <div class="academia-module-icon active">2</div>
                  <div class="academia-module-text">
                    Módulo 2: Ayuno y microbiota
                  </div>
                </div>
                <div class="academia-module locked">
                  <div class="academia-module-icon locked">🔒</div>
                  <div class="academia-module-text">
                    Módulo 3: Mantenimiento
                  </div>
                </div>
                <div class="academia-progress-box">
                  <div class="academia-progress-text">
                    <span>Progreso del paciente</span>
                    <span>33%</span>
                  </div>
                  <div class="academia-progress-bar-bg">
                    <div class="academia-progress-bar-fill"></div>
                  </div>
                </div>
              </div>

              <div class="academia-main">
                <div class="academia-player">
                  <div class="academia-play-glass">
                    <div class="academia-play-triangle"></div>
