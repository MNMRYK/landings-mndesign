              seoBloques.map((b) => (
                <article data-reveal class="card glass ring rounded-[24px] p-4 sm:p-5 flex flex-col">
                  <div class="flex items-center gap-3 mb-3">
                    <span class="icon-iris icon-iris-sm" set:html={icon(b.icono, "w-5 h-5")} />
                    <h4 class="text-base sm:text-lg font-extrabold tracking-tight leading-snug">{b.titulo}</h4>
                  </div>
                  <ul class="space-y-1.5 text-sm font-medium text-saas-muted">
