    <script define:vars={{ CAL_LINK }} is:inline>
      window.__CAL_LINK = CAL_LINK;
    </script>

    <script>
      /* =========================================
         EFECTOS (JS mínimo): aparición, brillo + tilt, botón magnético,
         carrusel, tarjeta activa y línea de progreso del proceso.
         ========================================= */
      const d = document;
      const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
      const fine = !reduce && matchMedia("(hover: hover) and (pointer: fine)").matches;

      // 0. Scroll suave con Lenis: solo escritorio con ratón y sin "reducir movimiento".
      //    Se importa aparte, así en móvil ni se descarga. Lenis mueve el scroll nativo de la
      //    ventana, por eso el sticky, los IntersectionObserver, el evento scroll y las
      //    animaciones CSS ligadas al scroll siguen sincronizados sin tocar nada.
      //    En táctil: scroll nativo con scroll-behavior: smooth y scroll-padding-top (style.css).
      let lenis: { scrollTo: Function; stop: Function; start: Function } | null = null;
      if (fine) {
        import("lenis").then(({ default: Lenis }) => {
          lenis = new Lenis({ autoRaf: true, lerp: 0.1 });
        });
        // Lenis no gestiona el teclado: si se pulsa una tecla de desplazamiento con una animación
        // de rueda en marcha, se corta en la posición actual y el teclado nativo manda.
        const TECLAS = ["ArrowUp", "ArrowDown", "PageUp", "PageDown", "Home", "End", " "];
        d.addEventListener("keydown", (e) => {
          const t = e.target as HTMLElement;
          if (!lenis || !TECLAS.includes(e.key) || t.closest("input, textarea, select, [contenteditable]")) return;
          lenis.scrollTo(scrollY, { immediate: true, force: true });
        });
        // Enlaces internos (menú, "Ver proyectos", CTA…). El destino sale de la posición real de la
        // página y del scroll-padding-top del <html> (la cabecera fija, en style.css); antes de
        // animar se resincroniza Lenis por si algo movió la página por fuera de él.
        d.addEventListener("click", (e) => {
          if (!lenis || e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey) return;
          const a = (e.target as HTMLElement).closest?.('a[href^="#"]');
          const id = a?.getAttribute("href")!.slice(1);
          const destino = id ? d.getElementById(id) : null;
          if (!destino) return;
          e.preventDefault();
          const cabecera = parseFloat(getComputedStyle(d.documentElement).scrollPaddingTop) || 0;
          const y = destino.getBoundingClientRect().top + scrollY - cabecera;
          lenis.scrollTo(scrollY, { immediate: true, force: true });
          lenis.scrollTo(y, { duration: 1.2 });
          history.pushState(null, "", `#${id}`);
          // Como un ancla normal: el foco pasa a la sección de destino (teclado y lectores de pantalla)
          if (!destino.hasAttribute("tabindex")) destino.setAttribute("tabindex", "-1");
          destino.focus({ preventScroll: true });
        });
      }

      // 1. Aparición al hacer scroll (solo lo que aún no se ve: sin parpadeo arriba)
      if ("IntersectionObserver" in window) {
        const io = new IntersectionObserver(
          (entries) =>
            entries.forEach((e) => {
              if (!e.isIntersecting) return;
              const el = e.target as HTMLElement;
              io.unobserve(el);
              el.classList.add("is-in");
              // Al acabar se quitan las clases (vuelven los hovers originales). Por si transitionend
              // no llega (pestaña en segundo plano, transición interrumpida), un temporizador lo
              // garantiza: nada se queda nunca a media opacidad.
              let timer = 0;
              const done = (ev?: Event) => {
                if (ev && ev.target !== el) return;
                clearTimeout(timer);
                el.removeEventListener("transitionend", done);
                el.classList.remove("reveal", "is-in");
                el.style.removeProperty("--d");
              };
              el.addEventListener("transitionend", done);
              timer = window.setTimeout(done, 1400 + (parseInt(el.style.getPropertyValue("--d")) || 0));
            }),
          { rootMargin: "0px 0px -6% 0px", threshold: 0 },
        );
        d.querySelectorAll<HTMLElement>("[data-reveal]").forEach((el) => {
          if (el.getBoundingClientRect().top < innerHeight) return;
          const hermanos = [...el.parentElement!.children].filter((c) => c.hasAttribute("data-reveal"));
          const i = Math.min(hermanos.indexOf(el), 4);
          if (i > 0) el.style.setProperty("--d", `${i * 90}ms`);
          el.classList.add("reveal");
          io.observe(el);
        });
      }

      // 2. Brillo que sigue al ratón + tilt (máx. ~5°) y botón magnético. Solo escritorio.
      if (fine) {
        d.querySelectorAll<HTMLElement>(".card").forEach((c) => {
          let raf = 0;
          c.addEventListener("pointermove", (e) => {
            const r = c.getBoundingClientRect();
            const x = (e.clientX - r.left) / r.width;
            const y = (e.clientY - r.top) / r.height;
            cancelAnimationFrame(raf);
            raf = requestAnimationFrame(() => {
              c.classList.add("is-tilting");
              c.style.setProperty("--x", `${x * 100}%`);
              c.style.setProperty("--y", `${y * 100}%`);
              c.style.setProperty("--rx", `${(0.5 - y) * 8}deg`);
              c.style.setProperty("--ry", `${(x - 0.5) * 10}deg`);
            });
          });
          c.addEventListener("pointerleave", () => {
            cancelAnimationFrame(raf);
            c.classList.remove("is-tilting");
            c.style.removeProperty("--rx");
            c.style.removeProperty("--ry");
          });
        });
        d.querySelectorAll<HTMLElement>(".magnetic").forEach((b) => {
          b.addEventListener("pointermove", (e) => {
            const r = b.getBoundingClientRect();
            b.style.setProperty("--mx", `${(e.clientX - r.left - r.width / 2) * 0.15}px`);
            b.style.setProperty("--my", `${(e.clientY - r.top - r.height / 2) * 0.3}px`);
          });
          b.addEventListener("pointerleave", () => {
            b.style.removeProperty("--mx");
            b.style.removeProperty("--my");
          });
        });
      }

      // 3. Carrusel: flechas y arrastre con ratón (en táctil, scroll nativo)
      d.querySelectorAll<HTMLElement>("[data-carousel]").forEach((wrap) => {
        const track = wrap.querySelector<HTMLElement>(".carousel")!;
        const prev = wrap.querySelector<HTMLButtonElement>("[data-prev]")!;
        const next = wrap.querySelector<HTMLButtonElement>("[data-next]")!;
        const paso = () => track.firstElementChild!.getBoundingClientRect().width + 24;
        const ir = (s: number) => track.scrollBy({ left: s * paso(), behavior: reduce ? "auto" : "smooth" });
        prev.addEventListener("click", () => ir(-1));
        next.addEventListener("click", () => ir(1));
        const flechas = () => {
          prev.disabled = track.scrollLeft < 8;
          next.disabled = track.scrollLeft + track.clientWidth > track.scrollWidth - 8;
        };
        track.addEventListener("scroll", () => requestAnimationFrame(flechas), { passive: true });
        flechas();

        let x0 = 0, s0 = 0, abajo = false, movido = false;
        track.addEventListener("pointerdown", (e) => {
          if (e.pointerType !== "mouse" || e.button !== 0) return;
          abajo = true;
          movido = false;
          x0 = e.clientX;
          s0 = track.scrollLeft;
        });
        addEventListener("pointermove", (e) => {
          if (!abajo) return;
          const dx = e.clientX - x0;
          if (!movido && Math.abs(dx) > 6) {
            movido = true;
            track.classList.add("is-dragging");
          }
          if (movido) track.scrollLeft = s0 - dx;
        });
        addEventListener("pointerup", () => {
          if (!abajo) return;
          abajo = false;
          track.classList.remove("is-dragging");
        });
        // Si se ha arrastrado, el clic no abre la demo
        track.addEventListener("click", (e) => {
          if (movido) {
            e.preventDefault();
            movido = false;
          }
        }, true);
      });

      // 4. "Por qué elegirnos": se ilumina la tarjeta que pasa por el centro
      const porque = d.querySelectorAll(".why-card");
      if (porque.length && "IntersectionObserver" in window) {
        const io2 = new IntersectionObserver(
          (entries) => entries.forEach((e) => e.target.classList.toggle("is-active", e.isIntersecting)),
          { rootMargin: "-42% 0px -42% 0px" },
        );
        porque.forEach((w) => io2.observe(w));
      }

      // 5. Proceso: la línea se rellena según el scroll y se encienden los pasos
      const steps = d.querySelector<HTMLElement>(".steps");
      if (steps) {
        const items = steps.querySelectorAll(".step");
        let visible = false;
        const tick = () => {
          const r = steps.getBoundingClientRect();
          const vh = innerHeight;
          const p = Math.min(1, Math.max(0, (vh * 0.8 - r.top) / (r.height + vh * 0.3)));
          steps.style.setProperty("--p", p.toFixed(3));
          items.forEach((s, i) => s.classList.toggle("is-on", p >= i / (items.length - 1) - 0.02));
        };
        new IntersectionObserver(([e]) => {
          visible = e.isIntersecting;
          if (visible) tick();
        }).observe(steps);
        addEventListener("scroll", () => visible && requestAnimationFrame(tick), { passive: true });
      }

      // 6. Menú móvil
      const btnMenu = d.getElementById("mobile-menu-btn");
      const menu = d.getElementById("mobile-dropdown");
      if (btnMenu && menu) {
        const abierto = () => !menu.hidden;
        const setMenu = (open: boolean, devolverFoco = false) => {
          if (open === abierto()) return;
          menu.hidden = !open;
          // Bloquea el scroll de la página mientras el menú está abierto (también el de Lenis,
          // que movería la ventana por código aunque el <html> tenga overflow: hidden)
          d.documentElement.classList.toggle("menu-open", open);
          if (open) lenis?.stop();
          else lenis?.start();
          btnMenu.setAttribute("aria-expanded", String(open));
          btnMenu.setAttribute("aria-label", open ? "Cerrar menú" : "Abrir menú");
          if (open) menu.querySelector<HTMLElement>("a")?.focus();
          else if (devolverFoco) btnMenu.focus();
        };
        btnMenu.addEventListener("click", (e) => {
          e.stopPropagation();
          setMenu(!abierto(), true);
        });
        // Al pulsar un enlace se cierra (y el ancla funciona porque el scroll ya está desbloqueado)
        menu.querySelectorAll(".mobile-link").forEach((l) => l.addEventListener("click", () => setMenu(false)));
        // Clic fuera del panel
        d.addEventListener("click", (e) => {
          if (abierto() && !menu.contains(e.target as Node)) setMenu(false);
        });
        // Escape devuelve el foco al botón
        d.addEventListener("keydown", (e) => {
          if (e.key === "Escape" && abierto()) setMenu(false, true);
        });
        // Si el foco de teclado sale del panel (Tab), se cierra
        menu.addEventListener("focusout", (e) => {
          const destino = (e as FocusEvent).relatedTarget as Node | null;
          if (destino && !menu.contains(destino) && destino !== btnMenu) setMenu(false);
        });
        // Al pasar a escritorio no puede quedarse abierto
        matchMedia("(min-width: 1024px)").addEventListener("change", (m) => m.matches && setMenu(false));
      }

      /* =========================================
         FORMULARIO, CAL.COM Y MEDICIÓN (igual que en el resto de landings)
         ========================================= */
      const w = window as any;

      function showToast(message: string, type = "success") {
        const container = d.getElementById("toast-container");
        if (!container) return;
        const toast = d.createElement("div");
        toast.className = `transform transition-all duration-300 translate-y-10 opacity-0 flex items-center gap-3 px-6 py-4 rounded-2xl shadow-2xl border font-semibold text-sm pointer-events-auto bg-white text-saas-ink ${
          type === "success" ? "border-saas-mint/40" : "border-red-200"
        }`;
        toast.textContent = message;
        container.appendChild(toast);
        setTimeout(() => toast.classList.remove("translate-y-10", "opacity-0"), 10);
        setTimeout(() => {
          toast.classList.add("translate-y-10", "opacity-0");
          setTimeout(() => toast.remove(), 300);
        }, 4000);
      }

      // Si un campo deja de existir, se envía vacío en vez de romper el envío
      const valor = (id: string) => (d.getElementById(id) as HTMLInputElement | null)?.value ?? "";
      const form = d.getElementById("formulario") as HTMLFormElement | null;
      if (form) {
        form.addEventListener("submit", (e) => {
          e.preventDefault();
          const btn = d.getElementById("btn-submit") as HTMLButtonElement;
          const textoOriginal = btn.innerText;
          btn.innerText = "Enviando...";
          btn.disabled = true;

          const data = {
            access_key: "1bc2d285-71cb-4fe3-806f-530066ab6e15",
            subject: "Nuevo Lead: Alcoy · Diseño web",
            nombre: valor("nombre"),
            email: valor("email"),
            telefono: valor("telefono"),
            negocio: valor("negocio"),
            mensaje: valor("mensaje"),
            privacidad: "Aceptada",
          };

          Promise.all([
            fetch("https://api.web3forms.com/submit", {
              method: "POST",
              headers: { "Content-Type": "application/json", Accept: "application/json" },
              body: JSON.stringify(data),
            }),
            fetch("https://hook.eu1.make.com/mxvqg7gwne43yab165v2uhtyw5yh115r", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify(data),
            }).catch(() => null),
          ])
            .then(async (results) => {
              const result = await results[0].json();
              if (!result.success) throw new Error("Error en el envío");
              w.enviarEvento("generate_lead", { formulario: "alcoy" });
              if (typeof w.fbq === "function") w.fbq("track", "Lead");
              if (typeof w.clarity === "function") w.clarity("set", "lead", "web");
              showToast("¡Mensaje enviado! Te contestamos muy pronto.", "success");
              form.reset();
            })
            .catch((error) => {
              console.error(error);
              showToast("Ha habido un error. Inténtalo de nuevo o escríbenos por WhatsApp.", "error");
            })
            .finally(() => {
              btn.innerText = textoOriginal;
              btn.disabled = false;
            });
        });
      }

      // Cal.com (embed oficial): se carga al acercarse a la sección de contacto
      const calBox = d.getElementById("cal-inline");
      if (calBox) {
        let calCargado = false;
        let reservado = false;
        const onBooked = () => {
          // Cal.com emite el evento antiguo y el V2: solo contamos una reserva
          if (reservado) return;
          reservado = true;
          w.enviarEvento("book_call", { method: "cal_com" });
          if (typeof w.fbq === "function") w.fbq("track", "Schedule");
          if (typeof w.clarity === "function") w.clarity("set", "lead", "reunion_alcoy");
        };
        const cargarCal = () => {
          if (calCargado) return;
          calCargado = true;
          (function (C: any, A: string, L: string) {
            const p = function (a: any, ar: any) {
              a.q.push(ar);
            };
            const doc = C.document;
            C.Cal =
              C.Cal ||
              function () {
                const cal = C.Cal;
                const ar = arguments;
                if (!cal.loaded) {
                  cal.ns = {};
                  cal.q = cal.q || [];
                  doc.head.appendChild(doc.createElement("script")).src = A;
                  cal.loaded = true;
                }
                if (ar[0] === L) {
                  const api: any = function () {
                    p(api, arguments);
                  };
                  const namespace = ar[1];
                  api.q = api.q || [];
                  if (typeof namespace === "string") {
                    cal.ns[namespace] = cal.ns[namespace] || api;
                    p(cal.ns[namespace], ar);
                    p(cal, ["initNamespace", namespace]);
                  } else p(cal, ar);
                  return;
                }
                p(cal, ar);
              };
          })(window, "https://app.cal.com/embed/embed.js", "init");

          w.Cal("init", "reunion", { origin: "https://cal.com" });
          w.Cal.ns.reunion("inline", {
            elementOrSelector: "#cal-inline",
            calLink: w.__CAL_LINK,
            config: { layout: "month_view" },
          });
          w.Cal.ns.reunion("ui", { hideEventTypeDetails: false, layout: "month_view" });
          w.Cal.ns.reunion("on", { action: "bookingSuccessfulV2", callback: onBooked });
          w.Cal.ns.reunion("on", { action: "bookingSuccessful", callback: onBooked });
        };
        if ("IntersectionObserver" in window) {
          const calObserver = new IntersectionObserver(
            (entries) => {
              if (entries[0].isIntersecting) {
                cargarCal();
                calObserver.disconnect();
              }
            },
            { rootMargin: "800px 0px" },
          );
          calObserver.observe(calBox);
        } else {
          cargarCal();
        }
      }
    </script>
  </body>
</html>
