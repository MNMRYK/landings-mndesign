/* Capturas de página completa de las demos (public/alcoi/demos/, 1280 px de ancho).
   --travel: cuánto sube la imagen dentro del marco 16:10 para enseñarla entera. */
const FRAME = 10 / 16;
const shot = (alto: number) => {
  const travel = Math.max(0, 1 - FRAME / (alto / 1280)) * 100;
  return `--travel:-${travel.toFixed(1)}%;--dur:${Math.max(1.5, travel / 10).toFixed(1)}s`;
};

