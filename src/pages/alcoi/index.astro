                            <span class="icon-iris icon-iris-sm" set:html={icon(Wrench, "w-5 h-5")} />
                            <h4 class="text-xl sm:text-2xl font-extrabold tracking-tight">
                              Mantenimiento web: <span class="text-iris">tú a lo tuyo, nosotros de tu web</span>
                            </h4>
                          </div>
                          <p class="text-sm sm:text-base font-semibold text-saas-muted mb-3">
                            Desde <strong class="text-saas-ink text-lg">65&nbsp;€/mes</strong> + IVA
                          </p>
                          <p class="text-sm sm:text-base text-saas-muted font-medium leading-relaxed">
                            Nos encargamos de tu web, esté hecha en código a medida o en WordPress, para que no tengas que
                            preocuparte de nada.
                          </p>
                        </div>
                        <div>
                          <ul class="space-y-2.5 text-sm sm:text-base font-medium text-saas-muted mb-5">
                            {mantenimiento.map((x) => (
                              <li class="flex gap-2">
                                <Fragment set:html={icon(Check, "w-4 h-4 text-saas-iris-ink shrink-0 mt-1")} />
