                    ))}
                  </ul>
                </article>
              ))
            }
          </div>

          <!-- Destacado: SEO + anuncios -->
          <div data-reveal class="glass ring ring-always rounded-[28px] p-5 sm:p-6 lg:p-7 mt-5 sm:mt-6 !bg-white/80" style="--ring-w:2px">
            <div class="grid grid-cols-1 lg:grid-cols-[1fr_1.15fr] gap-5 lg:gap-8">
              <div>
                <span class="icon-iris icon-iris-sm mb-3" set:html={icon(Megaphone, "w-5 h-5")} />
                <h3 class="text-xl sm:text-2xl font-extrabold tracking-tight mb-3">
                  ¿Quieres resultados desde el primer día? <span class="text-iris">Lo combinamos con anuncios</span>
                </h3>
                <p class="text-saas-muted font-medium leading-relaxed mb-5">
