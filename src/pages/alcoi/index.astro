        <div class="flex items-center gap-4">
          <a
            href="#contacte"
            class="hidden sm:inline-flex whitespace-nowrap bg-saas-dark hover:bg-black text-white px-6 py-2.5 rounded-full font-bold text-sm transition-all shadow hover:shadow-lg hover:-translate-y-0.5"
          >
            Diagnosi gratuïta
          </a>

          <button
            id="mobile-menu-btn"
            aria-label="Obrir menú"
            aria-expanded="false"
            aria-controls="mobile-dropdown"
            class="lg:hidden flex items-center justify-center w-10 h-10 bg-slate-50 border border-slate-200 rounded-xl text-slate-600 hover:text-saas-violet hover:bg-violet-50 transition-colors"
          >
            <i data-lucide="menu" class="w-5 h-5"></i>
          </button>
        </div>
      </div>

      <div
        id="mobile-dropdown"
        class="hidden absolute top-full left-0 w-full bg-white border-b border-slate-200 shadow-2xl px-6 py-6 flex-col gap-1 text-center lg:hidden max-h-[calc(100dvh-5rem)] overflow-y-auto"
      >
        <a
          href="#automatitzacio"
          class="mobile-link w-full py-3.5 text-lg font-bold text-slate-700 hover:text-saas-violet hover:bg-slate-50 rounded-2xl transition-colors"
          >Automatització</a
        >
        <a
          href="#serveis"
          class="mobile-link w-full py-3.5 text-lg font-bold text-slate-700 hover:text-saas-violet hover:bg-slate-50 rounded-2xl transition-colors"
          >Serveis</a
        >
        <a
          href="#branding"
          class="mobile-link w-full py-3.5 text-lg font-bold text-slate-700 hover:text-saas-violet hover:bg-slate-50 rounded-2xl transition-colors"
          >Branding</a
        >
        <a
          href="#portfolio"
          class="mobile-link w-full py-3.5 text-lg font-bold text-slate-700 hover:text-saas-violet hover:bg-slate-50 rounded-2xl transition-colors"
