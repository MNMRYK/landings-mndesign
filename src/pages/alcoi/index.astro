---
import "./style.css";
---

<!doctype html>
<html lang="ca" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Estudi de Disseny Web i Desenvolupament a Alcoi | MN Design</title>

    <meta
      name="theme-color"
      media="(prefers-color-scheme: light)"
      content="#FAFAFC"
    />
    <meta
      name="theme-color"
      media="(prefers-color-scheme: dark)"
      content="#0F172A"
    />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />

    <!-- URL CANÓNICA Y ROBOTS -->
    <link rel="canonical" href="https://descubre.mndesignweb.es/alcoi" />
    <link rel="icon" type="image/webp" href="/favicon_v2.webp" />
    <meta name="robots" content="index, follow" />

    <!-- METADATOS PRINCIPALES SEO (Valencià/Local) -->
    <meta
      name="description"
      content="Estudi de disseny web i desenvolupament a mida a Alcoi, Cocentaina i comarques. Creem botigues online, plataformes SaaS i webs corporatives d'alt rendiment."
    />
    <meta name="author" content="MN Design Web" />

    <!-- OPEN GRAPH (Facebook, LinkedIn, WhatsApp) -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://descubre.mndesignweb.es/alcoi" />
    <meta
      property="og:title"
      content="Estudi de Disseny Web i Desenvolupament a Alcoi | MN Design"
    />
    <meta
      property="og:description"
      content="Estudi de disseny web a Alcoi i Cocentaina. Creem botigues online, plataformes SaaS i webs corporatives d'alt rendiment. Acompanyament tecnològic proper i sense intermediaris."
    />
    <meta
      property="og:image"
      content="https://descubre.mndesignweb.es/alcoi/imagen-miniatura-alcoi.webp"
    />
    <meta property="og:locale" content="ca_ES" />

    <!-- TWITTER CARDS (X) -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content="https://descubre.mndesignweb.es/alcoi" />
    <meta
      name="twitter:title"
      content="Estudi de Disseny Web i Desenvolupament a Alcoi | MN Design"
    />
    <meta
      name="twitter:description"
      content="Estudi de disseny web a Alcoi i Cocentaina. Creem botigues online, plataformes SaaS i webs corporatives d'alt rendiment."
    />
    <meta
      name="twitter:image"
      content="https://descubre.mndesignweb.es/alcoi/imagen-miniatura-alcoi.webp"
    />

    <!-- RECURSOS GRÁFICOS Y FUENTES -->
    <script is:inline src="https://cdn.tailwindcss.com"></script>
    <script is:inline src="https://unpkg.com/lucide@latest"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />

    <script is:inline>
      tailwind.config = {
        theme: {
          extend: {
            fontFamily: { sans: ["Plus Jakarta Sans", "sans-serif"] },
            colors: {
              saas: {
                violet: "#8B5CF6",
                fuchsia: "#D946EF",
                mint: "#34D399",
                dark: "#0F172A",
                bg: "#FAFAFC",
              },
            },
            boxShadow: {
              card: "0 4px 24px -6px rgba(0, 0, 0, 0.03), 0 12px 32px -4px rgba(0, 0, 0, 0.04)",
              float: "0 20px 40px -10px rgba(139, 92, 246, 0.15)",
            },
            borderRadius: { "3xl": "1.75rem", "4xl": "2.5rem" },
          },
        },
      };
    </script>

    <!-- DATOS ESTRUCTURADOS (JSON-LD) OPTIMIZADOS PARA ALCOI -->
    <script type="application/ld+json">
      [
        {
          "@context": "https://schema.org",
          "@type": "WebPage",
          "name": "Estudi de Disseny Web i Desenvolupament a Alcoi | MN Design",
          "description": "Estudi de disseny web a Alcoi i Cocentaina. Creem botigues online, plataformes SaaS i webs corporatives d'alt rendiment."
        },
        {
          "@context": "https://schema.org",
          "@type": "ProfessionalService",
          "name": "MN Design Web",
          "image": "https://descubre.mndesignweb.es/logo.webp",
          "url": "https://descubre.mndesignweb.es/",
          "address": {
            "@type": "PostalAddress",
            "streetAddress": "Passeig del Comtat nº 75",
            "addressLocality": "Cocentaina",
            "addressRegion": "Alicante",
            "addressCountry": "ES"
          },
          "areaServed": ["Alcoi", "Cocentaina"],
          "priceRange": "$$"
        },
        {
          "@context": "https://schema.org/",
          "@type": "Service",
          "name": "Disseny i Desenvolupament Web",
          "image": "https://descubre.mndesignweb.es/alcoi/imagen-miniatura-alcoi.webp",
          "description": "Solucions digitals a mida: WordPress autogestionable, botigues online E-commerce amb Shopify/WooCommerce, plataformes SaaS i Branding."
        },
        {
          "@context": "https://schema.org",
          "@type": "FAQPage",
          "mainEntity": [
            {
              "@type": "Question",
              "name": "La web serà meua 100% o he de pagar un lloguer per sempre?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "La web i el domini són totalment teus des del primer minut. Treballem amb plataformes lliures i estàndards com WordPress o Shopify. Si algun dia decideixes treballar amb una altra agència, et donem les claus i te l'emportes sense penalitzacions ni lletra menuda."
              }
            },
            {
              "@type": "Question",
              "name": "Què passa si tinc un problema tècnic o vull fer canvis en un futur?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Ens tens a Cocentaina per a allò que necessites, no som un call center anònim. Oferim plans de manteniment web mensual on ens encarreguem de les actualitzacions, la seguretat i xicotets canvis."
              }
            },
            {
              "@type": "Question",
              "name": "Puc rebre reserves directes o vendre sense dependre de tercers?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "I tant! Integrem sistemes complets de reserves i botigues online totalment automatitzades, sincronitzades amb el teu calendari i passarel·les de pagament segures."
              }
            },
            {
              "@type": "Question",
              "name": "Apareixeré a Google si algú busca els meus serveis a la zona?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Totes les nostres webs s'entreguen amb una optimització SEO tècnica de base. A més, oferim estratègies específiques de SEO Local i configuració avançada de Google Business Profile per dominar l'Alcoià i el Comtat."
              }
            },
            {
              "@type": "Question",
              "name": "Quant de temps trigueu a tindre el disseny a punt?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Normalment una web corporativa està llesta entre 3 i 5 setmanes des que ens facilites els textos i imatges inicials."
              }
            }
          ]
        },
        {
          "@context": "https://schema.org",
          "@type": "BreadcrumbList",
          "itemListElement": [
            {
              "@type": "ListItem",
              "position": 1,
              "name": "Inici MN Design Web",
              "item": "https://mndesignweb.es/"
            },
            {
              "@type": "ListItem",
              "position": 2,
              "name": "Estudi de Disseny Web a Alcoi",
              "item": "https://descubre.mndesignweb.es/alcoi"
            }
          ]
        }
      ]
    </script>

    <!-- CONSENT MODE (Sincronizado con tu nuevo banner) -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      var localConsent = localStorage.getItem("cookies_accepted");
      if (localConsent === "true") {
        gtag("consent", "default", {
          ad_storage: "granted",
          ad_user_data: "granted",
          ad_personalization: "granted",
          analytics_storage: "granted",
        });
      } else {
        gtag("consent", "default", {
          ad_storage: "denied",
          ad_user_data: "denied",
          ad_personalization: "denied",
          analytics_storage: "denied",
          wait_for_update: 500,
        });
      }
    </script>

    <!-- GOOGLE ANALYTICS (GA4) -->
    <script
      is:inline
      async
      src="https://www.googletagmanager.com/gtag/js?id=G-36WYJMYT3Z"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("js", new Date());
      gtag("config", "G-36WYJMYT3Z");
    </script>

    <!-- META PIXEL (Facebook) -->
    <script is:inline>
      !(function (f, b, e, v, n, t, s) {
        if (f.fbq) return;
        n = f.fbq = function () {
          n.callMethod
            ? n.callMethod.apply(n, arguments)
            : n.queue.push(arguments);
        };
        if (!f._fbq) f._fbq = n;
        n.push = n;
        n.loaded = !0;
        n.version = "2.0";
        n.queue = [];
        t = b.createElement(e);
        t.async = !0;
        t.src = v;
        s = b.getElementsByTagName(e)[0];
        s.parentNode.insertBefore(t, s);
      })(
        window,
        document,
        "script",
        "https://connect.facebook.net/en_US/fbevents.js",
      );

      // Chequeo de consentimiento para el Píxel
      var localConsent = localStorage.getItem("cookies_accepted");
      if (localConsent !== "true") {
        fbq("consent", "revoke");
      }
      fbq("init", "1627135808585120");
      fbq("track", "PageView");
    </script>

    <!-- MICROSOFT CLARITY -->
    <script is:inline type="text/javascript">
      (function (c, l, a, r, i, t, y) {
        c[a] =
          c[a] ||
          function () {
            (c[a].q = c[a].q || []).push(arguments);
          };
        t = l.createElement(r);
        t.async = 1;
        t.src = "https://www.clarity.ms/tag/" + i;
        y = l.getElementsByTagName(r)[0];
        y.parentNode.insertBefore(t, y);
      })(window, document, "clarity", "script", "wuzaxaifa0");
    </script>
  </head>
  <body
    class="text-slate-800 antialiased selection:bg-saas-violet selection:text-white"
  >
    <header
      class="fixed top-0 left-0 w-full z-[100] bg-white/80 backdrop-blur-md border-b border-slate-200/50"
    >
      <div
        class="max-w-7xl mx-auto px-6 h-20 flex items-center justify-between"
      >
        <!-- Logo -->
        <a href="/" class="flex items-center gap-3 group">
          <div
            class="flex items-center justify-center w-10 h-10 rounded-xl bg-gradient-to-br from-saas-violet to-indigo-600 shadow-md shadow-saas-violet/20 transition-transform group-hover:scale-110"
          >
            <span class="text-lg font-black tracking-tighter text-white"
              >MN</span
            >
          </div>
          <div class="hidden sm:flex flex-col justify-center">
            <span
              class="text-base font-extrabold text-slate-900 tracking-tight leading-none mb-0.5"
              >Design Web</span
            >
            <span
              class="text-[9px] font-bold text-saas-violet uppercase tracking-[0.2em] leading-none"
              >Estudi</span
            >
          </div>
        </a>

        <!-- Menú de Navegación Desktop -->
        <nav
          class="hidden md:flex items-center gap-8 font-semibold text-sm text-slate-600"
        >
          <a href="#serveis" class="hover:text-saas-violet transition-colors"
            >Serveis</a
          >
          <a href="#branding" class="hover:text-saas-violet transition-colors"
            >Branding</a
          >
          <a href="#portfolio" class="hover:text-saas-violet transition-colors"
            >Casos d'èxit</a
          >
          <a href="#nosaltres" class="hover:text-saas-violet transition-colors"
            >Nosaltres</a
          >
        </nav>

        <div class="flex items-center gap-4">
          <a
            href="#contacte"
            class="hidden sm:inline-flex bg-saas-dark hover:bg-black text-white px-6 py-2.5 rounded-full font-bold text-sm transition-all shadow hover:shadow-lg hover:-translate-y-0.5"
          >
            Reserva
          </a>
          <button
            class="md:hidden text-slate-600 hover:text-saas-violet transition-colors"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              ><line x1="4" x2="20" y1="12" y2="12"></line><line
                x1="4"
                x2="20"
                y1="6"
                y2="6"></line><line x1="4" x2="20" y1="18" y2="18"></line></svg
            >
          </button>
        </div>
      </div>
      <div
        id="mobile-dropdown"
        class="hidden absolute top-20 left-0 w-full bg-white/95 backdrop-blur-md border-b border-slate-200 shadow-2xl px-6 py-8 flex-col gap-6 text-center md:hidden"
      >
        <a
          href="#serveis"
          class="mobile-link text-xl font-extrabold text-slate-800 hover:text-saas-violet"
          >Serveis</a
        >
        <a
          href="#branding"
          class="mobile-link text-xl font-extrabold text-slate-800 hover:text-saas-violet"
          >Branding</a
        >
        <a
          href="#portfolio"
          class="mobile-link text-xl font-extrabold text-slate-800 hover:text-saas-violet"
          >Casos d'èxit</a
        >
        <a
          href="#nosaltres"
          class="mobile-link text-xl font-extrabold text-slate-800 hover:text-saas-violet"
          >Nosaltres</a
        >
        <a
          href="#contacte"
          class="mobile-link text-xl font-black text-saas-violet mt-2"
          >Reserva Consultoria</a
        >
      </div>
    </header>

    <!-- FONDOS ESTILO SAAS (Confinados a la cabecera) -->
    <div
      class="absolute top-0 left-0 w-full h-[500px] overflow-hidden -z-10 pointer-events-none"
    >
      <div
        class="absolute top-[-30%] left-[-10%] w-[50%] h-[400px] rounded-[100%] bg-saas-mint opacity-25 blur-[100px]"
      >
      </div>
      <div
        class="absolute top-[-40%] left-1/2 -translate-x-1/2 w-[70%] h-[500px] rounded-[100%] bg-saas-violet opacity-30 blur-[120px]"
      >
      </div>
      <div
        class="absolute top-[-30%] right-[-10%] w-[50%] h-[400px] rounded-[100%] bg-saas-fuchsia opacity-25 blur-[100px]"
      >
      </div>
      <div
        class="absolute inset-0 bg-gradient-to-b from-transparent via-transparent to-[#FAFAFC]"
      >
      </div>
    </div>

    <!-- 1. HERO SECTION -->
    <section
      class="relative max-w-7xl mx-auto px-6 pt-36 pb-20 flex flex-col items-center text-center z-10"
    >
      <div
        class="inline-flex items-center gap-2 px-4 py-2 rounded-full border border-slate-200 bg-white/80 backdrop-blur-sm shadow-sm mb-8 text-xs font-bold text-slate-600 tracking-wide uppercase"
      >
        <span class="w-2 h-2 rounded-full bg-saas-violet animate-pulse"></span>
        Presencia Digital en Alcoi
      </div>
      <h1
        class="text-4xl sm:text-[4rem] lg:text-[5rem] font-extrabold leading-[1.1] sm:leading-[1.05] tracking-tighter text-saas-dark mb-6 max-w-4xl mx-auto break-words"
      >
        Disseny i Desenvolupament Web<br class="hidden md:block" />
        <span class="text-saas-violet">d'Alt Rendiment</span>
      </h1>
      <p
        class="text-lg md:text-xl text-slate-500 max-w-2xl mx-auto leading-relaxed mb-10 font-medium"
      >
        Hola! Som un estudi local format exclusivament per dissenyadors i
        desenvolupadors en Cocentaina, Alcoi. Construïm solucions digitals a
        mida per a empreses de les nostres comarques, oferint un acompanyament
        tecnològic proper, transparent i sense intermediaris.
      </p>
      <div
        class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-16 w-full sm:w-auto"
      >
        <a
          href="#contacte"
          class="inline-flex justify-center items-center w-full sm:w-auto bg-saas-dark hover:bg-black text-white px-8 py-4 rounded-full font-semibold text-base transition-all shadow-float hover:shadow-2xl hover:-translate-y-1"
        >
          Reserva consultoria
        </a>
        <a
          href="#serveis"
          class="inline-flex justify-center items-center w-full sm:w-auto bg-white hover:bg-slate-50 border border-slate-200 text-saas-dark px-8 py-4 rounded-full font-semibold text-base transition-all shadow-sm hover:shadow-md"
        >
          Servicis
        </a>
      </div>
      <div
        class="flex flex-wrap items-center justify-center gap-8 md:gap-12 mb-16 opacity-40 grayscale"
      >
        <span class="font-bold text-xl tracking-tight">WordPress</span>
        <span class="font-bold text-xl tracking-tight">WooCommerce</span>
        <span class="font-bold text-xl tracking-tight">Shopify</span>
        <span class="font-bold text-xl tracking-tight">PrestaShop</span>
        <span class="font-bold text-xl tracking-tight">SaaS</span>
        <span class="font-bold text-xl tracking-tight">App</span>
        <span class="font-bold text-xl tracking-tight">Astro</span>
        <span class="font-bold text-xl tracking-tight">React</span>
        <span class="font-bold text-xl tracking-tight">Node.js</span>
      </div>
      <div
        class="relative w-full max-w-5xl mx-auto rounded-3xl sm:rounded-[2rem] bg-white/60 backdrop-blur-md border border-slate-200 shadow-[0_30px_60px_-15px_rgba(0,0,0,0.1)] p-2 sm:p-4 anim-float"
      >
        <img
          src="alcoi/software-nutricion.webp"
          alt="Plataforma de Nutrició - MN Design Web"
          class="w-full h-auto rounded-2xl sm:rounded-3xl shadow-sm border border-slate-100 block"
        />
      </div>
      <div class="mt-20 max-w-3xl mx-auto flex flex-col items-center">
        <p
          class="text-xl sm:text-2xl font-semibold text-saas-dark tracking-tight leading-snug mb-8"
        >
          "Aquesta plataforma ha transformat la nostra presència digital amb un
          disseny impecable i un acompanyament que ens ha fet estalviar hores de
          feina."
        </p>
        <div class="flex items-center gap-4">
          <div
            class="w-12 h-12 rounded-full bg-slate-200 overflow-hidden flex items-center justify-center"
          >
            <img
              src="alcoi/ilargi.webp"
              alt="Ilargi Tattoo"
              class="w-full h-full object-cover"
            />
          </div>
          <div class="text-left">
            <p class="font-bold text-saas-dark text-sm">Ilargi Tattoo</p>
            <p class="text-slate-500 text-sm">Estudi Tattoo Alcoi</p>
          </div>
        </div>
      </div>
    </section>

    <!-- 2. BENTO GRID SERVICES -->
    <section id="serveis" class="relative py-10 z-10 bg-slate-50">
      <div class="max-w-7xl mx-auto px-6">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <div
            class="rounded-4xl p-8 lg:p-10 flex flex-col relative overflow-hidden group bg-gradient-to-br from-violet-100 via-fuchsia-50 to-white border border-violet-200 hover:shadow-[0_20px_40px_-10px_rgba(139,92,246,0.2)] transition-all duration-300"
          >
            <div
              class="w-16 h-16 rounded-2xl bg-[#21759B]/10 flex items-center justify-center mb-6 shadow-sm group-hover:scale-110 transition-transform p-3"
            >
              <img
                src="alcoi/wordpress.webp"
                alt="WordPress"
                class="w-full h-full object-contain"
              />
            </div>
            <div class="flex items-center justify-between mb-3">
              <h3 class="text-2xl font-extrabold tracking-tight text-slate-900">
                WordPress Autogestionable
              </h3>
            </div>
            <div
              class="text-saas-violet font-black text-lg mb-3 tracking-tight"
            >
              Des de 500€
            </div>
            <p class="text-slate-600 font-medium leading-relaxed">
              Webs corporatives d'alt impacte. Disseny a mida, velocitat extrema
              i
              <strong class="text-saas-violet"> 3 hores de formació</strong> perquè
              tinguis el control total.
            </p>
          </div>

          <div
            class="rounded-4xl p-8 lg:p-10 flex flex-col relative overflow-hidden group bg-gradient-to-br from-lime-100 via-emerald-50 to-white border border-lime-200 hover:shadow-[0_20px_40px_-10px_rgba(16,185,129,0.2)] transition-all duration-300"
          >
            <div class="flex items-center gap-3 mb-6">
              <div
                class="w-16 h-16 rounded-2xl bg-[#95BF47]/10 flex items-center justify-center shadow-sm group-hover:scale-110 transition-transform p-3"
              >
                <img
                  src="alcoi/shopify.webp"
                  alt="Shopify"
                  class="w-full h-full object-contain"
                />
              </div>
              <div
                class="w-16 h-16 rounded-2xl bg-[#96588A]/10 flex items-center justify-center shadow-sm group-hover:scale-110 transition-transform p-3"
              >
                <img
                  src="alcoi/woocommerce.webp"
                  alt="WooCommerce"
                  class="w-full h-full object-contain"
                />
              </div>
            </div>
            <h3
              class="text-2xl font-extrabold tracking-tight text-slate-900 mb-3 mt-auto"
            >
              E-commerce & Botigues Online
            </h3>
            <div
              class="text-saas-violet font-black text-lg mb-3 tracking-tight"
            >
              Des de 790€
            </div>
            <p class="text-slate-600 font-medium leading-relaxed">
              Botigues online optimitzades per a màxima conversió o codi a mida.
              Integrem passarel·les de pagament segures, gestió d'estoc i
              enviaments.
            </p>
          </div>

          <div
            class="rounded-4xl p-8 lg:p-10 flex flex-col relative overflow-hidden group bg-gradient-to-br from-cyan-100 via-sky-50 to-white border border-cyan-200 hover:shadow-[0_20px_40px_-10px_rgba(6,182,212,0.2)] transition-all duration-300"
          >
            <div
              class="w-16 h-16 rounded-2xl bg-emerald-500/10 flex items-center justify-center mb-6 shadow-sm group-hover:scale-110 transition-transform p-3"
            >
              <img
                src="alcoi/academia.webp"
                alt="Academies Online"
                class="w-full h-full object-contain"
              />
            </div>
            <h3
              class="text-2xl font-extrabold tracking-tight text-slate-900 mb-3 mt-auto"
            >
              Acadèmies Online
