            <Fragment set:html={icon(Check, "w-4 h-4 text-saas-iris-ink")} /> Reunión en persona en Alcoy o Cocentaina
          </li>
          <li class="flex items-center gap-2">
            <Fragment set:html={icon(Check, "w-4 h-4 text-saas-iris-ink")} /> La web y el dominio son tuyos
          </li>
          <li class="flex items-center gap-2">
            <Fragment set:html={icon(Check, "w-4 h-4 text-saas-iris-ink")} /> Presupuesto cerrado antes de empezar
          </li>
        </ul>

        <!-- Tarjeta de cristal con una demo dentro de un marco de navegador -->
        <div class="relative max-w-5xl mx-auto">
