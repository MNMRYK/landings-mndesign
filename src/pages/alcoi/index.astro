  "Diseño de páginas web en Alcoy (Alcoi) desde 390 € + IVA: webs rápidas, SEO local y avanzado y presupuesto cerrado. Llamada gratuita de 30 min.";
const ogDescription =
  "Empresa de diseño web en Alcoy (Alcoi): webs one page, landing pages, webs corporativas y tiendas online desde 390 €, y posicionamiento web y SEO. Presupuesto cerrado tras una llamada gratuita.";
// Miniatura en castellano (1200×630). La valenciana (imagen-miniatura-alcoi.webp) es solo de /software-a-mida-alcoi/
const ogImage = "https://mndesignweb.es/alcoi/og-diseno-web-alcoy.webp";

const lugar = (tipo: string, nombre: string) => ({ "@type": tipo, name: nombre });
const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": `${pageUrl}#webpage`,
      url: pageUrl,
      name: seoTitle,
      description: seoDescription,
      inLanguage: "es-ES",
      about: { "@id": "https://mndesignweb.es/#empresa" },
      breadcrumb: { "@id": `${pageUrl}#breadcrumb` },
    },
    {
      "@type": "ProfessionalService",
      "@id": "https://mndesignweb.es/#empresa",
      name: "MN Design Web",
      description:
        "Estudio de diseño web, tiendas online, SEO local y software a medida en Cocentaina, para negocios de Alcoy (Alcoi), Ibi y la comarca.",
      image: "https://mndesignweb.es/logo.webp",
      logo: "https://mndesignweb.es/logo.webp",
      url: "https://mndesignweb.es/",
      telephone: "+34645854934",
      email: "info@mndesignweb.es",
      address: {
        "@type": "PostalAddress",
        streetAddress: "Passeig del Comtat, 75, 5º 1º",
        postalCode: "03820",
        addressLocality: "Cocentaina",
        addressRegion: "Alicante",
        addressCountry: "ES",
      },
      areaServed: [
        lugar("City", "Alcoy"),
        lugar("City", "Cocentaina"),
        lugar("City", "Ibi"),
        lugar("AdministrativeArea", "l'Alcoià"),
        lugar("AdministrativeArea", "El Comtat"),
      ],
      priceRange: "€€",
      hasOfferCatalog: {
        "@type": "OfferCatalog",
        name: "Diseño de páginas web, SEO y software en Alcoy",
        itemListElement: [
          ...[...preciosWeb, ...preciosSeo].map((p) => ({
            "@type": "Offer",
            itemOffered: { "@type": "Service", name: p.titulo, areaServed: lugar("City", "Alcoy") },
            priceSpecification: {
              "@type": "PriceSpecification",
              minPrice: Number(p.precio.replace(".", "")),
              priceCurrency: "EUR",
              valueAddedTaxIncluded: false,
            },
          })),
          // Servicios creativos (con Lara Summers), enlazados a sus páginas de la web principal
          ...creativos.map((c) => ({
            "@type": "Offer",
            itemOffered: {
              "@type": "Service",
              "@id": `${c.href}#servicio`,
              name: c.titulo,
              description: `${c.texto} ${c.incluye.join(". ")}.`,
              url: c.href,
              provider: { "@id": "https://mndesignweb.es/#empresa" },
              areaServed: lugar("City", "Alcoy"),
            },
            priceSpecification: {
              "@type": "PriceSpecification",
              minPrice: Number(c.precio),
              priceCurrency: "EUR",
              valueAddedTaxIncluded: false,
            },
          })),
        ],
      },
    },
    {
      "@type": "FAQPage",
      "@id": `${pageUrl}#faq`,
      mainEntity: faqs.map(([q, a]) => ({
        "@type": "Question",
        name: q,
        acceptedAnswer: { "@type": "Answer", text: a.replace(/<[^>]+>/g, "") },
      })),
    },
    {
      "@type": "BreadcrumbList",
      "@id": `${pageUrl}#breadcrumb`,
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Inicio", item: "https://mndesignweb.es/" },
        { "@type": "ListItem", position: 2, name: "Diseño web en Alcoy", item: pageUrl },
      ],
    },
  ],
};

const marquee = [
  "WordPress",
  "Shopify",
  "WooCommerce",
  "SEO local",
  "Perfil de Empresa de Google",
  "Astro",
  "React",
  "Reservas online",
  "Pagos con tarjeta",
  "Automatizaciones",
  "Portal de clientes",
  "Branding",
];
---

<!doctype html>
<html lang="es-ES" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{seoTitle}</title>
    <meta name="description" content={seoDescription} />
    <link rel="canonical" href={pageUrl} />
    <meta name="robots" content="index, follow" />
    <meta name="author" content="MN Design Web" />
    <link rel="icon" href="/marca/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/marca/favicon.svg" />
    <link rel="apple-touch-icon" href="/marca/apple-touch-icon.png" />
    <link rel="manifest" href="/marca/site.webmanifest" />
    <meta name="theme-color" content="#F8F6FF" />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:title" content={seoTitle} />
    <meta
      property="og:description"
      content={ogDescription}
    />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content="MN Design Web" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={pageUrl} />
    <meta name="twitter:title" content={seoTitle} />
    <meta
      name="twitter:description"
      content={seoDescription}
    />
    <meta name="twitter:image" content={ogImage} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />

    <!-- Schema.org: un único bloque generado desde el frontmatter (sin aggregateRating ni Review) -->
    <script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />

    <CookiesHead />
    <PortalLeads />

    <!-- Efectos ligados al scroll (scroll-driven animations, solo CSS). Inline porque el
         minificador fusiona animation-timeline dentro de animation y el navegador descarta la regla. -->
    <style is:inline>
      .scroll-progress {
        display: none;
      }
      @supports (animation-timeline: scroll()) {
        .scroll-progress {
          display: block;
          position: absolute;
          left: 0;
          bottom: -1px;
          width: 100%;
          height: 3px;
          background: linear-gradient(90deg, #7c5cff, #e25fd0, #6ee7f0);
          transform-origin: 0 50%;
          animation: scroll-progress linear both;
          animation-timeline: scroll(root);
        }
        @keyframes scroll-progress {
          from { transform: scaleX(0); }
          to { transform: scaleX(1); }
        }
        /* Parallax suave del velo del hero (solo escritorio) */
        @media (min-width: 768px) and (prefers-reduced-motion: no-preference) {
          .veil-hero {
            animation: veil-parallax linear both;
            animation-timeline: scroll(root);
            animation-range: 0 100vh;
          }
          @keyframes veil-parallax {
            to { transform: translateY(18vh); }
          }
        }
      }
      @media (prefers-reduced-motion: reduce) {
        .scroll-progress {
          animation: none !important;
        }
      }
    </style>
  </head>
  <body class="font-sans text-saas-ink antialiased selection:bg-saas-iris selection:text-white">
    <!-- Base de toda la página: casi blanco + grano sutil. El color va por secciones (.veil). -->
    <div class="iris-bg" aria-hidden="true"></div>

    <header class="header-glass fixed top-0 left-0 w-full z-[100]">
      <div class="max-w-7xl mx-auto px-gutter h-20 flex items-center justify-between">
        <a href="/" class="flex items-center gap-3 group shrink-0">
          <img
            src="/marca/logo-blanco.svg"
            width="40"
            height="40"
            alt=""
            class="w-8 h-8 sm:w-9 sm:h-9 transition-transform group-hover:scale-110"
          />
          <span class="text-[1.05rem] sm:text-xl tracking-tight leading-none whitespace-nowrap"><span class="font-extrabold text-[#1E1446]">MN</span> <span class="font-normal text-[#7330CC]">Design Web</span></span>
        </a>

        <nav aria-label="Secciones" class="hidden lg:flex items-center gap-8 font-semibold text-sm text-saas-muted">
          <a href="#servicios" class="hover:text-saas-iris-ink transition-colors">Servicios y precios</a>
          <a href="#proyectos" class="hover:text-saas-iris-ink transition-colors">Proyectos</a>
          <a href="#seo-avanzado" class="hover:text-saas-iris-ink transition-colors">SEO</a>
          <a href="#por-que" class="hover:text-saas-iris-ink transition-colors">Por qué nosotros</a>
          <a href="#preguntas" class="hover:text-saas-iris-ink transition-colors">Preguntas</a>
        </nav>

        <div class="flex items-center gap-3">
          <a href="#contacto" class="btn btn-primary ring !hidden sm:!inline-flex !py-2.5 !px-5 text-sm">Llamada gratuita</a>
          <button
            id="mobile-menu-btn"
            type="button"
            aria-label="Abrir menú"
            aria-expanded="false"
            aria-controls="mobile-dropdown"
            class="menu-btn lg:hidden flex items-center justify-center w-11 h-11 rounded-xl btn-glass"
          >
            <Fragment set:html={icon(Menu, "i-menu w-5 h-5")} />
            <Fragment set:html={icon(X, "i-close w-5 h-5")} />
          </button>
        </div>
      </div>
      <div class="scroll-progress" aria-hidden="true"></div>
    </header>

    <!-- Menú móvil: hermano del header (no hijo) para que su backdrop-filter desenfoque la página.
         Un backdrop-filter dentro de otro backdrop-filter no ve el contenido de detrás. -->
    <nav id="mobile-dropdown" aria-label="Menú" class="mobile-panel lg:hidden" data-lenis-prevent hidden>
      <a href="#servicios" class="mobile-link">Servicios y precios</a>
      <a href="#proyectos" class="mobile-link">Proyectos</a>
      <a href="#seo-avanzado" class="mobile-link">SEO</a>
      <a href="#por-que" class="mobile-link">Por qué nosotros</a>
      <a href="#preguntas" class="mobile-link">Preguntas</a>
      <a href="#contacto" class="mobile-link btn btn-primary w-full mt-3">Agendar llamada gratuita</a>
    </nav>

    <!-- overflow-x: clip (no hidden) para que velos y aurora no ensanchen la página en móvil sin romper el sticky -->
    <main class="overflow-x-clip">
      <!-- 1. HERO (color 1 de 3: velo iridiscente propio) -->
      <section class="relative isolate">
      <div class="veil veil-hero" aria-hidden="true"><i></i><i></i><i></i></div>
      <div class="relative max-w-7xl mx-auto px-gutter pt-28 sm:pt-36 pb-14 sm:pb-20 text-center">
        <div class="aurora" aria-hidden="true"></div>

        <p
          style="--d: 0ms"
          class="hero-in glass inline-flex items-center gap-2 px-4 py-2 rounded-full mb-6 sm:mb-8 text-[11px] sm:text-xs font-bold text-saas-ink tracking-wide uppercase"
        >
          <span class="w-2 h-2 rounded-full bg-gradient-to-r from-saas-iris to-saas-magenta animate-pulse"></span>
          Desde Cocentaina · Alcoy, Ibi y l'Alcoià
        </p>

        <h1
          style="--d: 60ms"
          class="hero-in hero-in-move text-[2.15rem] leading-[1.1] sm:text-5xl lg:text-[4.4rem] font-extrabold sm:leading-[1.04] tracking-tighter text-saas-ink mb-6 max-w-5xl mx-auto break-words"
        >
          <span class="text-iris">Agencia de diseño web en Alcoy (Alcoi)</span>: páginas web que trabajan por tu negocio
        </h1>

        <p
          style="--d: 140ms"
          class="hero-in hero-in-move text-base sm:text-lg md:text-xl text-saas-muted max-w-2xl mx-auto leading-relaxed mb-8 sm:mb-10 font-medium"
        >
          Somos una agencia de diseño web de la comarca. Hacemos páginas web en Alcoy (Alcoi) rápidas, bonitas y fáciles de
          encontrar en Google, y cuando hace falta les añadimos reservas, cobros online o automatizaciones para que
          te ahorren trabajo de verdad.
        </p>

        <!-- Línea de confianza -->
        <p
          style="--d: 180ms"
          class="hero-in glass inline-flex flex-wrap items-center justify-center gap-x-2.5 gap-y-1 px-5 py-2.5 rounded-full mb-8 sm:mb-10 text-sm sm:text-[15px] font-bold text-saas-ink"
        >
          <span>Presupuesto cerrado</span>
          <span aria-hidden="true" class="text-saas-iris-ink">·</span>
          <span>Webs desde 390&nbsp;€</span>
          <span aria-hidden="true" class="text-saas-iris-ink">·</span>
          <span>Llamada gratuita de 30&nbsp;min</span>
        </p>

        <!-- Móvil: texto → formulario → botones. Desde sm: botones → formulario. -->
        <div class="flex flex-col">
          <div
            style="--d: 220ms"
            class="hero-in order-2 sm:order-1 flex flex-col sm:flex-row items-center justify-center gap-3 sm:gap-4 mb-8 sm:mb-10"
          >
            <a href="#contacto" class="btn btn-primary ring ring-spin magnetic w-full sm:w-auto text-[15px] sm:text-base">
              Agendar llamada gratuita de 30 min
              <Fragment set:html={icon(ArrowRight, "w-4 h-4")} />
            </a>
            <a href="#proyectos" class="btn btn-glass w-full sm:w-auto text-[15px] sm:text-base">Ver proyectos</a>
          </div>

          <!-- Formulario corto: mismo envío que el de contacto (Web3Forms + copia al portal + generate_lead) -->
          <form
            id="form-hero"
            novalidate
            aria-labelledby="form-hero-titulo"
            style="--d: 260ms"
            class="hero-in order-1 sm:order-2 glass ring rounded-[28px] p-5 sm:p-6 w-full max-w-4xl mx-auto mb-8 sm:mb-10 text-left"
          >
            <p id="form-hero-titulo" class="text-lg sm:text-xl font-extrabold tracking-tight mb-1">Pide tu presupuesto de página web</p>
            <p class="text-sm text-saas-muted font-medium mb-4">Te llamamos o te escribimos por WhatsApp en menos de 24 h.</p>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 sm:gap-4">
              <div>
                <label for="hero-nombre" class="block text-sm font-bold">Nombre</label>
                <input id="hero-nombre" name="nombre" type="text" required autocomplete="name" aria-describedby="hero-nombre-error" class="field mt-1.5" />
                <p id="hero-nombre-error" class="hero-error" hidden>Escribe tu nombre.</p>
              </div>
              <div>
                <label for="hero-telefono" class="block text-sm font-bold">Teléfono o WhatsApp</label>
                <input id="hero-telefono" name="telefono" type="tel" required autocomplete="tel" inputmode="tel" aria-describedby="hero-telefono-error" class="field mt-1.5" />
                <p id="hero-telefono-error" class="hero-error" hidden>Escribe un teléfono válido (al menos 9 cifras).</p>
              </div>
              {/* Píldoras (radios) en lugar de <select>: la lista nativa no se puede estilizar en Windows.
                  Teclado nativo de los radios: Tab entra en el grupo, flechas cambian y Espacio marca. */}
              <fieldset id="hero-servicio" class="chips sm:col-span-2" aria-describedby="hero-servicio-error">
                <legend class="block text-sm font-bold">¿Qué necesitas?</legend>
                <div class="flex flex-wrap gap-2 mt-1.5">
                  {SERVICIOS_HERO.map((op) => (
                    <label class="chip">
                      <input type="radio" name="servicio" value={op} required class="chip-input" />
                      <span>{op}</span>
                    </label>
                  ))}
                </div>
                <p id="hero-servicio-error" class="hero-error" hidden>Elige qué necesitas.</p>
              </fieldset>
            </div>
            <div class="mt-4 flex flex-col sm:flex-row sm:items-center gap-3 sm:gap-6">
              <div class="flex-1">
                <label class="flex items-start gap-3 text-sm text-saas-muted font-medium cursor-pointer">
                  <input id="hero-privacidad" type="checkbox" required aria-describedby="hero-privacidad-error" class="mt-0.5 w-4 h-4 shrink-0 accent-saas-iris cursor-pointer" />
                  <span>
                    He leído y acepto la <a
                      href="https://mndesignweb.es/privacidad/"
                      target="_blank"
                      rel="noopener"
                      class="text-saas-iris-ink font-bold underline">política de privacidad</a
                    >.
                  </span>
                </label>
                <p id="hero-privacidad-error" class="hero-error" hidden>Tienes que aceptar la política de privacidad.</p>
              </div>
              <button id="btn-hero" type="submit" class="btn btn-primary ring w-full sm:w-auto shrink-0">Quiero mi presupuesto</button>
            </div>
            <p id="hero-estado" role="status" aria-live="polite" class="text-sm font-bold mt-3 empty:hidden"></p>
          </form>
        </div>

        <ul
          style="--d: 300ms"
          class="hero-in flex flex-col sm:flex-row sm:flex-wrap items-start sm:items-center justify-center gap-x-8 gap-y-2.5 mb-12 sm:mb-16 text-sm font-semibold text-saas-muted text-left w-fit mx-auto"
        >
          <li class="flex items-center gap-2">
            <Fragment set:html={icon(Check, "w-4 h-4 text-saas-iris-ink")} /> Reunión en persona en Alcoy o Cocentaina
          </li>
          <li class="flex items-center gap-2">
            <Fragment set:html={icon(Check, "w-4 h-4 text-saas-iris-ink")} /> La web y el dominio son tuyos
          </li>
          <li class="flex items-center gap-2">
            <Fragment set:html={icon(Check, "w-4 h-4 text-saas-iris-ink")} /> Presupuesto cerrado antes de empezar
          </li>
        </ul>

        <!-- Tarjeta de cristal con una demo dentro de un marco de navegador -->
        <div class="relative max-w-5xl mx-auto">
          <div class="glass float rounded-[28px] sm:rounded-[32px] p-2 sm:p-3">
            <div class="rounded-[22px] overflow-hidden bg-white/70 border border-white">
              <div class="browser-bar" aria-hidden="true">
                <i></i><i></i><i></i>
                <span class="browser-url">mnmryk.github.io/demo-suministros</span>
              </div>
              <!-- Primera pantalla de la demo (1440×900, mismo 16:10 que el marco: no se desplaza) -->
              <div class="shot">
                <img
                  src="/alcoi/demos/suministros-hero-1440.webp"
                  srcset="/alcoi/demos/suministros-hero-720.webp 720w, /alcoi/demos/suministros-hero-1440.webp 1440w, /alcoi/demos/suministros-hero-2880.webp 2880w"
                  sizes="(min-width: 1024px) 1000px, 92vw"
                  width="1440"
                  height="900"
                  fetchpriority="high"
                  decoding="async"
                  alt="Demo de página web diseñada por MN Design Web: web de Norvia Suministros, almacén de material eléctrico, fontanería y suministro industrial"
                />
              </div>
            </div>
          </div>
          <!-- Avisos flotantes: ilustran funciones que integramos (decorativos). Colocados donde no tapan texto de la captura: abajo a la izquierda (zona vacía) y arriba a la derecha (sobre la foto) -->
          <div
            aria-hidden="true"
            class="glass float-delay hidden xl:flex absolute -left-14 bottom-3 items-center gap-3 rounded-2xl px-4 py-3 text-left"
          >
            <span class="icon-iris !w-10 !h-10" set:html={icon(Repeat, "w-5 h-5")} />
            <span>
              <span class="block text-sm font-extrabold">Pedido repetido</span>
              <span class="block text-xs font-semibold text-saas-muted">En 1 clic</span>
            </span>
          </div>
          <div
            aria-hidden="true"
            class="glass float hidden xl:flex absolute -right-12 top-[30%] items-center gap-3 rounded-2xl px-4 py-3 text-left"
          >
            <span class="icon-iris !w-10 !h-10" set:html={icon(Tag, "w-5 h-5")} />
            <span>
              <span class="block text-sm font-extrabold">Tarifa profesional</span>
              <span class="block text-xs font-semibold text-saas-muted">Aplicada</span>
            </span>
          </div>
        </div>
      </div>
      </section>

      <!-- 2. FRANJA MARQUEE -->
      <section aria-label="Tecnologías y servicios" class="relative px-gutter pb-16 sm:pb-24">
        <div class="glass marquee max-w-6xl mx-auto rounded-full py-4 text-sm sm:text-base font-bold text-saas-ink">
          <div class="marquee-track">
            <ul class="marquee-list">{marquee.map((m) => <li>{m}</li>)}</ul>
            <ul class="marquee-list" aria-hidden="true">{marquee.map((m) => <li>{m}</li>)}</ul>
          </div>
        </div>
      </section>

      <!-- 3. SERVICIOS Y PRECIOS (#servicios; tarjetas en #precios). Sustituye a las antiguas secciones de
           servicios y de precios. Ningún enlace sale de la landing: los botones van a #contacto. -->
      <section id="servicios" class="relative isolate py-12 sm:py-20">
        <div class="halo halo-servicios" aria-hidden="true"></div>
        <div class="max-w-7xl mx-auto px-gutter">
          <div class="text-center mb-10 sm:mb-14 max-w-3xl mx-auto" data-reveal>
            <p class="text-xs font-bold uppercase tracking-[0.18em] text-saas-iris-ink mb-4">Servicios y precios</p>
            <h2 class="text-3xl md:text-5xl font-extrabold tracking-tighter mb-5">
              <span class="text-iris">Diseño de páginas web en Alcoy</span>: servicios y precios
            </h2>
            <p class="text-base sm:text-lg text-saas-muted font-medium">
              Webs rápidas, que aparecen en Google y consiguen que te llamen. Precios orientativos; el presupuesto
              cerrado te lo damos tras la llamada.
            </p>
          </div>

          <div id="precios" class="space-y-12 sm:space-y-16">
            {
              gruposPrecios.map((g, gi) => (
                <div>
                  <h3 class="text-xl sm:text-2xl font-extrabold tracking-tight mb-5 sm:mb-6" data-reveal>{g.titulo}</h3>
                  {/* .precios-grid + .precio-card (iris.css): cada tarjeta es un subgrid de 6 filas
                      (título, tipo, texto, precio, lista y botones), así todas miden lo mismo y cada
                      fila queda alineada con la de las tarjetas vecinas. */}
                  <div class:list={["precios-grid relative grid grid-cols-1 sm:grid-cols-2 gap-x-5", gi === 0 ? "lg:grid-cols-4" : "lg:grid-cols-3"]}>
                    {/* Toque de color detrás de la tarjeta destacada, para que se note el cristal */}
                    {gi === 0 && <div class="halo halo-precio" aria-hidden="true" />}
                    {g.items.map((p) => (
                      <article
                        data-reveal
                        class:list={["precio-card card glass ring rounded-[28px] p-5 sm:p-7 flex flex-col", p.etiqueta && "ring-always ring-spin !bg-white/80"]}
                        style={p.etiqueta ? "--ring-w:2px" : undefined}
                      >
                        {p.etiqueta && (
                          <span class="precio-etiqueta inline-flex items-center gap-1.5 rounded-full bg-saas-ink text-white text-sm font-bold px-3 py-1.5 whitespace-nowrap">
                            <Fragment set:html={icon(Sparkles, "w-3.5 h-3.5")} />
                            {p.etiqueta}
                          </span>
                        )}
                        <h4 class="text-xl font-extrabold tracking-tight mb-1">{p.titulo}</h4>
                        {p.tipo ? (
                          <p class="text-xs font-bold uppercase tracking-wider text-saas-iris-ink mb-2">{p.tipo}</p>
