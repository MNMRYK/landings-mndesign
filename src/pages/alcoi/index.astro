    <!-- SCRIPT FUNCIONALIDAD TOASTS, COOKIES Y FORMULARIO -->
    <script is:inline>
      // 1. LÓGICA DE NOTIFICACIONES TOAST (Faltaba esto)
      function showToast(message, type = "success") {
        const container = document.getElementById("toast-container");
        if (!container) return; // Por si acaso no encuentra el contenedor

        const toast = document.createElement("div");

        toast.className = `transform transition-all duration-300 translate-y-10 opacity-0 flex items-center gap-3 px-6 py-4 rounded-2xl shadow-2xl border font-semibold text-sm pointer-events-auto bg-white text-slate-800 ${
          type === "success" ? "border-saas-mint/30" : "border-red-200"
        }`;

        const icon =
          type === "success"
            ? `<div class="w-8 h-8 rounded-full bg-saas-mint/10 text-saas-mint flex items-center justify-center shrink-0"><svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path></svg></div>`
            : `<div class="w-8 h-8 rounded-full bg-red-100 text-red-500 flex items-center justify-center shrink-0"><svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M6 18L18 6M6 6l12 12"></path></svg></div>`;

        toast.innerHTML = `${icon} <span>${message}</span>`;
        container.appendChild(toast);

        // Animación de entrada
        setTimeout(
          () => toast.classList.remove("translate-y-10", "opacity-0"),
          10,
        );

        // Animación de salida
        setTimeout(() => {
          toast.classList.add("translate-y-10", "opacity-0");
          setTimeout(() => toast.remove(), 300);
        }, 4000);
      }

      document.addEventListener("DOMContentLoaded", () => {
        // 2. LÓGICA DE COOKIES
        const cookieBanner = document.getElementById("cookie-banner");
        const acceptBtn = document.getElementById("btn-accept-cookies");
        const declineBtn = document.getElementById("btn-decline-cookies");

        if (cookieBanner && acceptBtn && declineBtn) {
          if (!localStorage.getItem("cookies_accepted")) {
            cookieBanner.classList.remove("translate-y-[150%]", "opacity-0");
          } else {
            cookieBanner.style.display = "none";
          }

          const hideBanner = () => {
            cookieBanner.classList.add("translate-y-[150%]", "opacity-0");
            setTimeout(() => {
              cookieBanner.style.display = "none";
            }, 500);
          };

          acceptBtn.addEventListener("click", () => {
            localStorage.setItem("cookies_accepted", "true");
            hideBanner();
          });

          declineBtn.addEventListener("click", () => {
            localStorage.setItem("cookies_accepted", "false");
            hideBanner();
          });
        }

        // 3. LÓGICA DE ENVÍO DEL FORMULARIO
        const formWeb = document.getElementById("formulario");

        if (formWeb) {
          formWeb.addEventListener("submit", function (e) {
            e.preventDefault();

            const btn = document.getElementById("btn-submit");
            const originalText = btn.innerText;
            btn.innerText = "Enviant...";
            btn.disabled = true;

            const data = {
              access_key: "1bc2d285-71cb-4fe3-806f-530066ab6e15",
              subject: "Nuevo Lead: Landing Web Alcoi",
              nombre: document.getElementById("nombre").value,
              email: document.getElementById("email").value,
              telefono: document.getElementById("telefono").value,
              mensaje: document.getElementById("mensaje").value,
            };

            Promise.all([
              fetch("https://api.web3forms.com/submit", {
                method: "POST",
                headers: {
                  "Content-Type": "application/json",
                  Accept: "application/json",
                },
                body: JSON.stringify(data),
              }),
              fetch(
                "https://hook.eu1.make.com/mxvqg7gwne43yab165v2uhtyw5yh115r",
                {
                  method: "POST",
                  headers: { "Content-Type": "application/json" },
                  body: JSON.stringify(data),
                },
              ),
            ])
              .then(async (results) => {
                const result = await results[0].json();
                if (result.success) {
                  // Eventos de conversión
                  if (typeof gtag === "function")
                    gtag("event", "generate_lead", {
                      currency: "EUR",
                      value: 0,
                    });
                  if (typeof fbq === "function") fbq("track", "Lead");
                  if (typeof clarity === "function")
                    clarity("set", "lead", "web");

                  // Mostrar Toast de Éxito
                  showToast(
                    "Missatge enviat correctament! Et contactarem prompte.",
                    "success",
                  );
                  formWeb.reset();
                } else {
                  throw new Error("Error en l'enviament");
                }
              })
              .catch((error) => {
                console.error(error);
                // Mostrar Toast de Error
                showToast(
                  "Hi ha hagut un error. Torna a intentar-ho.",
                  "error",
                );
              })
              .finally(() => {
                btn.innerText = originalText;
                btn.disabled = false;
              });
          });
        }
        // 4. LÓGICA DEL MENÚ MÓVIL
        const btnMenu = document.getElementById("mobile-menu-btn");
        const dropdownMenu = document.getElementById("mobile-dropdown");
        const mobileLinks = document.querySelectorAll(".mobile-link");

        if (btnMenu && dropdownMenu) {
          // Abrir/Cerrar al tocar el botón
          btnMenu.addEventListener("click", () => {
            dropdownMenu.classList.toggle("hidden");
            dropdownMenu.classList.toggle("flex");
          });

          // Cerrar el menú automáticamente al tocar un enlace
          mobileLinks.forEach((link) => {
            link.addEventListener("click", () => {
              dropdownMenu.classList.add("hidden");
              dropdownMenu.classList.remove("flex");
            });
          });
        }
      });
    </script>
