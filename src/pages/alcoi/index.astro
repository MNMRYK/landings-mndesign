        >
          Diagnosi gratuïta
        </a>
      </div>
      <!-- Barra de progreso de lectura (solo CSS, scroll-driven animations) -->
      <div class="scroll-progress" aria-hidden="true"></div>
    </header>

    <main>
      <div
        class="hero-glow absolute top-0 left-0 w-full h-[500px] overflow-hidden -z-10 pointer-events-none"
      >
        <div
          class="absolute top-[-30%] left-[-10%] w-[50%] h-[400px] rounded-[100%] bg-saas-mint opacity-25 blur-[100px]"
        >
        </div>
        <div
