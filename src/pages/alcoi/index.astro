      <div class="flex gap-4 w-full justify-center mt-4">
        <button
          id="btn-accept-cookies"
          class="w-36 h-11 bg-saas-violet hover:bg-saas-dark text-white font-bold rounded-full shadow-lg shadow-saas-violet/30 transition-all hover:-translate-y-1"
          >Permetre</button
        >
        <button
          id="btn-decline-cookies"
          class="w-36 h-11 bg-transparent border border-slate-200 text-slate-500 hover:text-slate-900 hover:border-slate-300 font-bold rounded-full transition-all hover:-translate-y-1"
          >Rebutjar</button
