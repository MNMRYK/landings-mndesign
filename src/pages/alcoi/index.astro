    />

    <!-- Schema.org: un único bloque generado desde el frontmatter (sin aggregateRating ni Review) -->
    <script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />

    <CookiesHead />

    <!-- Efectos ligados al scroll (scroll-driven animations, solo CSS). Inline porque el
         minificador fusiona animation-timeline dentro de animation y el navegador descarta la regla. -->
    <style is:inline>
      .scroll-progress {
        display: none;
      }
      @supports (animation-timeline: scroll()) {
        .scroll-progress {
          display: block;
          position: absolute;
          left: 0;
          bottom: -1px;
          width: 100%;
          height: 3px;
          background: linear-gradient(90deg, #7c5cff, #e25fd0, #6ee7f0);
          transform-origin: 0 50%;
          animation: scroll-progress linear both;
          animation-timeline: scroll(root);
        }
        @keyframes scroll-progress {
          from { transform: scaleX(0); }
          to { transform: scaleX(1); }
        }
        /* Parallax suave del velo del hero (solo escritorio) */
        @media (min-width: 768px) and (prefers-reduced-motion: no-preference) {
          .veil-hero {
            animation: veil-parallax linear both;
            animation-timeline: scroll(root);
            animation-range: 0 100vh;
          }
          @keyframes veil-parallax {
            to { transform: translateY(18vh); }
          }
        }
      }
      @media (prefers-reduced-motion: reduce) {
        .scroll-progress {
          animation: none !important;
        }
      }
    </style>
  </head>
