                  <a
                    href={s.enlace.href}
                    hreflang={s.destacado ? "ca" : undefined}
                    class="mt-auto inline-flex items-center gap-1.5 font-bold text-saas-iris-ink hover:gap-2.5 transition-all w-fit"
                  >
                    {s.enlace.texto}
                    <Fragment set:html={icon(ArrowRight, "w-4 h-4")} />
                  </a>
                </article>
              ))
            }
          </div>
        </div>
      </section>

      <!-- 4. POR QUÉ ELEGIRNOS (título fijo a la izquierda en escritorio) -->
      <section id="por-que" class="relative isolate py-16 sm:py-24">
