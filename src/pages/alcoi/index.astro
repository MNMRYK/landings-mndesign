                  <p class="text-saas-muted font-medium leading-relaxed">{m.texto}</p>
                </li>
              ))
            }
          </ol>
        </div>
      </section>

      <!-- 5. PROYECTOS Y DEMOS: carrusel con scroll-snap, arrastrable y con flechas -->
      <section id="proyectos" class="relative isolate py-16 sm:py-24" data-carousel>
        <!-- [PENDIENTE: proyecto o cliente real de Alcoy] Cuando lo haya, va el primero del carrusel -->
        <div class="max-w-7xl mx-auto px-gutter flex flex-col md:flex-row md:items-end justify-between gap-6 mb-6 sm:mb-8">
