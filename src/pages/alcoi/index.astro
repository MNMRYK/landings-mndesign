    <!-- Schema.org: un únic bloc generat des del frontmatter -->
    <script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />

    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }

      // CAMBIADO: Usamos la misma clave que en las otras landings
