                          <span class="text-4xl font-black tracking-tighter">{p.precio}&nbsp;€</span>
                          <span class="block text-sm font-semibold text-saas-muted mt-1">IVA no incluido</span>
                        </p>
                        <ul class="space-y-2.5 text-sm font-medium text-saas-muted mb-6">
                          {p.incluye.map((x) => (
                            <li class="flex gap-2">
                              <Fragment set:html={icon(Check, "w-4 h-4 text-saas-iris-ink shrink-0 mt-0.5")} />
                              {x}
                            </li>
                          ))}
                        </ul>
                        <div class="precio-acciones mt-auto flex flex-col gap-3">
                          {p.enlace && (
                            <a
                              href={p.enlace.href}
                              class="inline-flex items-center gap-1.5 text-sm font-bold text-saas-iris-ink hover:gap-2.5 transition-all w-fit"
