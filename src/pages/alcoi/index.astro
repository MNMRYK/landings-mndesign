        >
        </div>
      </div>

      <!-- CAPÇALERA: software a mida i automatització per a la indústria local -->
      <section
        class="relative max-w-7xl mx-auto px-6 pt-28 sm:pt-36 pb-16 sm:pb-20 flex flex-col items-center text-center z-10"
      >
        <div
          style="--d: 0ms"
          class="hero-in inline-flex items-center gap-2 px-4 py-2 rounded-full border border-slate-200 bg-white/80 backdrop-blur-sm shadow-sm mb-6 sm:mb-8 text-[11px] sm:text-xs font-bold text-slate-600 tracking-wide uppercase"
        >
          <span class="w-2 h-2 rounded-full bg-saas-violet animate-pulse"
          ></span>
          Des de Cocentaina · Alcoi i comarques
        </div>
        <h1
          style="--d: 60ms"
          class="hero-in hero-in-move text-[2rem] sm:text-5xl lg:text-[4.25rem] font-extrabold leading-[1.12] sm:leading-[1.05] tracking-tighter text-saas-dark mb-6 max-w-5xl mx-auto break-words"
        >
          Software a mida i automatització de processos per a{" "}
          <span class="text-saas-violet">empreses i indústries de l'Alcoià i el Comtat</span>
        </h1>
        <p
          style="--d: 140ms"
          class="hero-in hero-in-move text-base sm:text-lg md:text-xl text-slate-500 max-w-2xl mx-auto leading-relaxed mb-8 sm:mb-10 font-medium"
        >
          Connectem comandes, producció, magatzem i facturació perquè els
          vostres departaments deixen de passar-se dades en fulls d'Excel. Venim
          a la vostra empresa, entenem com treballeu i automatitzem el que ara
          feu a mà.
        </p>
        <div
          style="--d: 220ms"
          class="hero-in flex flex-col sm:flex-row items-center justify-center gap-3 sm:gap-4 mb-10 sm:mb-12 w-full sm:w-auto"
        >
          <a
            href="#contacte"
            class="inline-flex justify-center items-center w-full sm:w-auto bg-saas-dark hover:bg-black text-white px-6 sm:px-8 py-4 rounded-full font-semibold text-[15px] sm:text-base transition-all shadow-float hover:shadow-2xl hover:-translate-y-1"
          >
            Sol·liciteu una diagnosi gratuïta
          </a>
          <a
            href="https://mndesignweb.es/supplyconnect/"
            target="_blank"
            rel="noopener"
            class="inline-flex justify-center items-center gap-2 w-full sm:w-auto bg-white hover:bg-slate-50 border border-slate-200 text-saas-dark px-6 sm:px-8 py-4 rounded-full font-semibold text-[15px] sm:text-base transition-all shadow-sm hover:shadow-md"
          >
            Proveu la demo d'un ERP industrial
            <i data-lucide="external-link" class="w-4 h-4"></i>
          </a>
        </div>
        <ul
          style="--d: 300ms"
          class="hero-in flex flex-col sm:flex-row sm:flex-wrap items-start sm:items-center justify-center gap-x-8 gap-y-2.5 mb-12 sm:mb-16 text-sm font-semibold text-slate-600 text-left"
        >
