                    <span class="leading-tight">
                      <span class="block font-bold text-sm">{r.nombre}</span>
                      {r.detalle && <span class="block text-xs text-saas-muted mt-0.5">{r.detalle}</span>}
                    </span>
                  </figcaption>
                </figure>
              </li>
            ))
          }
        </ul>

        <div class="text-center mt-5 sm:mt-6 px-gutter" data-reveal>
          <a href={GOOGLE_RESENAS} target="_blank" rel="noopener" class="btn btn-glass">
            Ver todas las reseñas en Google
            <Fragment set:html={icon(ExternalLink, "w-4 h-4")} />
            <span class="sr-only">(se abre en una pestaña nueva)</span>
          </a>
        </div>
      </section>

      <!-- 6. POSICIONAMIENTO WEB Y SEO (#seo-avanzado): qué incluye el SEO avanzado y cómo funciona la
