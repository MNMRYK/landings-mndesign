              Lo que dicen quienes ya <span class="text-iris">han trabajado con nosotros</span>
            </h2>
          </div>
        </div>

        <!-- Móvil: carrusel táctil con scroll-snap. Tablet: 2×2. Escritorio (≥1200 px): una fila de 4.
             Todas las tarjetas con el mismo alto. -->
        <ul class="resenas" aria-label="Reseñas de clientes" data-lenis-prevent-horizontal>
          {
            resenas.map((r) => (
              <li data-reveal>
                <figure class="resena glass ring rounded-[24px] h-full flex flex-col" style="--ring-o:0.5">
                  <div class="flex items-center justify-between gap-2 mb-3 min-h-[1.75rem]">
                    {r.google ? (
                      <span class="stars" role="img" aria-label="5 de 5 estrellas">
                        {[0, 1, 2, 3, 4].map(() => (
                          <svg viewBox="0 0 20 20" class="w-4 h-4" aria-hidden="true">
                            <path d="M10 1.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8L10 14.8l-5.2 2.8 1-5.8L1.5 7.7l5.9-.9z" />
                          </svg>
                        ))}
                      </span>
                    ) : (
                      <span class="icon-iris !w-7 !h-7" set:html={icon(Quote, "w-3.5 h-3.5")} />
                    )}
                    {/* Misma píldora para "Reseña de Google" y "Cliente" */}
                    <span class="pill-resena">
                      {r.google && (
                        <img src="/psicologos/google-logo.webp" width="96" height="96" loading="lazy" decoding="async" alt="" class="w-3.5 h-3.5" />
                      )}
                      {r.google ? "Reseña de Google" : "Cliente"}
                    </span>
                  </div>
                  <blockquote class="resena-texto">«{r.texto}»</blockquote>
                  <figcaption class="mt-4 flex items-center gap-2.5">
                    {r.foto ? (
                      <img
                        src={r.foto}
                        srcset={`${r.foto} 1x, ${r.foto.replace(".webp", "@2x.webp")} 2x`}
                        width="96"
                        height="96"
                        loading="lazy"
                        decoding="async"
                        alt=""
                        class="w-9 h-9 rounded-full object-cover shrink-0"
                      />
                    ) : r.google ? (
                      <span class="w-9 h-9 rounded-full grid place-items-center text-sm font-extrabold text-white bg-gradient-to-br from-[#6a45f5] to-[#c23bb0] shrink-0" aria-hidden="true">
