                              {p.enlace.texto}
                              <Fragment set:html={icon(ArrowRight, "w-4 h-4")} />
                            </a>
                          )}
                          <a href="#contacto" class:list={["btn w-full text-sm", p.etiqueta ? "btn-grad" : "btn-glass"]}>
