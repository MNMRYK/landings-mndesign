    <script is:inline>
      // 1. LÓGICA DE NOTIFICACIONES TOAST
      function showToast(message, type = "success") {
        const container = document.getElementById("toast-container");
        if (!container) return;

        const toast = document.createElement("div");

        toast.className = `transform transition-all duration-300 translate-y-10 opacity-0 flex items-center gap-3 px-6 py-4 rounded-2xl shadow-2xl border font-semibold text-sm pointer-events-auto bg-white text-slate-800 ${
          type === "success" ? "border-saas-mint/30" : "border-red-200"
        }`;

        const icon =
          type === "success"
            ? `<div class="w-8 h-8 rounded-full bg-saas-mint/10 text-saas-mint flex items-center justify-center shrink-0"><svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path></svg></div>`
            : `<div class="w-8 h-8 rounded-full bg-red-100 text-red-500 flex items-center justify-center shrink-0"><svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M6 18L18 6M6 6l12 12"></path></svg></div>`;

        toast.innerHTML = `${icon} <span>${message}</span>`;
        container.appendChild(toast);

        setTimeout(
          () => toast.classList.remove("translate-y-10", "opacity-0"),
          10,
        );

        setTimeout(() => {
          toast.classList.add("translate-y-10", "opacity-0");
          setTimeout(() => toast.remove(), 300);
        }, 4000);
      }

      document.addEventListener("DOMContentLoaded", () => {
        // 2. LÓGICA DE COOKIES
        const cookieBanner = document.getElementById("cookie-banner");
        const acceptBtn = document.getElementById("btn-accept-cookies");
        const declineBtn = document.getElementById("btn-decline-cookies");

        if (cookieBanner && acceptBtn && declineBtn) {
          if (!localStorage.getItem("cookie_consent")) {
            cookieBanner.style.display = "flex";
          }

          const hideBanner = () => {
            cookieBanner.classList.add("translate-y-[150%]", "opacity-0");
            setTimeout(() => {
              cookieBanner.style.display = "none";
            }, 500);
          };

          acceptBtn.addEventListener("click", () => {
            localStorage.setItem("cookie_consent", "accepted");
            hideBanner();

            if (typeof gtag === "function") {
              gtag("consent", "update", {
                ad_storage: "granted",
                ad_user_data: "granted",
                ad_personalization: "granted",
                analytics_storage: "granted",
              });
            }
            if (typeof fbq === "function") {
              fbq("consent", "grant");
            }

            // Clarity no es carrega sense consentiment: el carreguem ara i donem el senyal
            if (typeof window.clarity === "undefined") {
              (function (c, l, a, r, i, t, y) {
                c[a] =
                  c[a] ||
                  function () {
                    (c[a].q = c[a].q || []).push(arguments);
                  };
                t = l.createElement(r);
                t.async = 1;
                t.src = "https://www.clarity.ms/tag/" + i;
                y = l.getElementsByTagName(r)[0];
                y.parentNode.insertBefore(t, y);
              })(window, document, "clarity", "script", "wuzaxaifa0");
            }
            window.clarity("consent");
          });

          declineBtn.addEventListener("click", () => {
            localStorage.setItem("cookie_consent", "declined");
            hideBanner();

            if (typeof gtag === "function") {
              gtag("consent", "update", {
                ad_storage: "denied",
                ad_user_data: "denied",
                ad_personalization: "denied",
                analytics_storage: "denied",
              });
            }
            if (typeof fbq === "function") fbq("consent", "revoke");
          });
        }

        // 3. LÓGICA DE ENVÍO DEL FORMULARIO
        const formWeb = document.getElementById("formulario");

        if (formWeb) {
          formWeb.addEventListener("submit", function (e) {
            e.preventDefault();

            const btn = document.getElementById("btn-submit");
            const originalText = btn.innerText;
            btn.innerText = "Enviant...";
            btn.disabled = true;

            const data = {
              access_key: "1bc2d285-71cb-4fe3-806f-530066ab6e15",
              subject: "Nuevo Lead: Alcoi · Software y automatización",
              nombre: document.getElementById("nombre").value,
              email: document.getElementById("email").value,
              telefono: document.getElementById("telefono").value,
              mensaje: document.getElementById("mensaje").value,
              empresa: document.getElementById("empresa").value,
              sector: document.getElementById("sector").value,
              treballadors: document.getElementById("treballadors").value,
              privacidad: "Aceptada",
            };

            Promise.all([
              fetch("https://api.web3forms.com/submit", {
                method: "POST",
                headers: {
                  "Content-Type": "application/json",
                  Accept: "application/json",
                },
                body: JSON.stringify(data),
              }),
              fetch(
                "https://hook.eu1.make.com/mxvqg7gwne43yab165v2uhtyw5yh115r",
                {
                  method: "POST",
                  headers: { "Content-Type": "application/json" },
                  body: JSON.stringify(data),
                },
              ),
            ])
              .then(async (results) => {
                const result = await results[0].json();
                if (result.success) {
                  if (typeof gtag === "function")
                    gtag("event", "generate_lead", {
                      currency: "EUR",
                      value: 0,
                    });
                  if (typeof fbq === "function") fbq("track", "Lead");
                  if (typeof clarity === "function")
                    clarity("set", "lead", "web");

                  showToast(
                    "Missatge enviat correctament! Us contactarem prompte.",
                    "success",
                  );
                  formWeb.reset();
                } else {
                  throw new Error("Error en l'enviament");
                }
              })
              .catch((error) => {
                console.error(error);

                showToast(
                  "Hi ha hagut un error. Torneu a intentar-ho.",
                  "error",
                );
              })
              .finally(() => {
                btn.innerText = originalText;
                btn.disabled = false;
              });
          });
        }
        // 4. CAL.COM (embed oficial) + MESURAMENT DE RESERVES
        // Es carrega en acostar-se a la secció de contacte per no alentir la càrrega inicial
        const calBox = document.getElementById("cal-inline");
        if (calBox) {
          let calLoaded = false;
          let booked = false;

          const onBooked = () => {
            // Cal.com emet l'esdeveniment antic i el V2: només comptem una reserva
            if (booked) return;
            booked = true;
            if (typeof gtag === "function")
              gtag("event", "book_call", { method: "cal_com" });
            if (typeof fbq === "function") fbq("track", "Schedule");
            if (typeof window.clarity === "function")
              window.clarity("set", "lead", "reunio_alcoi");
          };

          const loadCal = () => {
            if (calLoaded) return;
            calLoaded = true;
            (function (C, A, L) {
              const p = function (a, ar) {
                a.q.push(ar);
              };
              const d = C.document;
              C.Cal =
                C.Cal ||
                function () {
                  const cal = C.Cal;
                  const ar = arguments;
                  if (!cal.loaded) {
                    cal.ns = {};
                    cal.q = cal.q || [];
                    d.head.appendChild(d.createElement("script")).src = A;
                    cal.loaded = true;
                  }
                  if (ar[0] === L) {
                    const api = function () {
                      p(api, arguments);
                    };
                    const namespace = ar[1];
                    api.q = api.q || [];
                    if (typeof namespace === "string") {
                      cal.ns[namespace] = cal.ns[namespace] || api;
                      p(cal.ns[namespace], ar);
                      p(cal, ["initNamespace", namespace]);
                    } else p(cal, ar);
                    return;
                  }
                  p(cal, ar);
                };
            })(window, "https://app.cal.com/embed/embed.js", "init");

            Cal("init", "reunio", { origin: "https://cal.com" });
            Cal.ns.reunio("inline", {
              elementOrSelector: "#cal-inline",
              calLink: "mndesignweb/reunio-30-min",
              config: { layout: "month_view" },
            });
            Cal.ns.reunio("ui", { hideEventTypeDetails: false, layout: "month_view" });
            Cal.ns.reunio("on", { action: "bookingSuccessfulV2", callback: onBooked });
            Cal.ns.reunio("on", { action: "bookingSuccessful", callback: onBooked });
          };

          if ("IntersectionObserver" in window) {
            const calObserver = new IntersectionObserver(
              (entries) => {
                if (entries[0].isIntersecting) {
                  loadCal();
                  calObserver.disconnect();
                }
              },
              { rootMargin: "800px 0px" },
            );
            calObserver.observe(calBox);
          } else {
            loadCal();
          }
        }

        // 5. MESURAMENT DE CLICS EN TELÈFON, WHATSAPP I EMAIL
        document.addEventListener("click", (e) => {
          const link = e.target.closest && e.target.closest("a[href]");
          if (!link) return;
          const href = link.getAttribute("href");
          let tipo = null;
          if (href.startsWith("tel:")) tipo = "phone";
          else if (href.includes("wa.me") || href.includes("whatsapp")) tipo = "whatsapp";
          else if (href.startsWith("mailto:")) tipo = "email";
          if (!tipo) return;
          if (typeof gtag === "function")
            gtag("event", "click_" + tipo, { link_url: href });
          if (typeof fbq === "function") fbq("track", "Contact", { content_name: tipo });
        });

        // 6. APARICIÓ EN FER SCROLL
        // Només als elements que encara no es veuen (sense parpelleig a dalt)
        // i res si l'usuari té activat "reduir moviment".
        if (
          "IntersectionObserver" in window &&
          !window.matchMedia("(prefers-reduced-motion: reduce)").matches
        ) {
          const isMobile = window.matchMedia("(max-width: 639px)").matches;
          const targets = new Set();
          // Capçalera de cada secció (el bloc que conté el h2), excepte el hero
          document.querySelectorAll("main h2").forEach((h) => targets.add(h.parentElement));
          [
            "#automatitzacio .grid > *",
            "#demos article",
            "#diagnosi ol > li",
            "#diagnosi ol + div",
            "#serveis .grid > *",
            "#serveis + div > div",
            // En mòbil el portfolio és un carrusel horitzontal: s'anima sencer
            isMobile ? "#portfolio .no-scrollbar" : "#portfolio .no-scrollbar > a",
            "#branding h3",
            "#nosaltres + div a",
            "main details",
            "#contacte > div",
          ].forEach((sel) => document.querySelectorAll(sel).forEach((el) => targets.add(el)));
          // La caixa del pack de branding, no només el seu títol
          const brandingTitle = document.querySelector("#branding h3");
          if (brandingTitle) {
            targets.delete(brandingTitle);
            targets.add(brandingTitle.parentElement);
          }

          const revealObserver = new IntersectionObserver(
            (entries) => {
              entries.forEach((entry) => {
                if (!entry.isIntersecting) return;
                const el = entry.target;
                el.classList.add("is-in");
                revealObserver.unobserve(el);
                // En acabar, traiem les classes perquè tornen els hovers originals
                const done = (e) => {
                  // Ignorem les transicions dels fills (p. ex. hover d'un botó)
                  if (e.target !== el) return;
                  el.removeEventListener("transitionend", done);
                  el.classList.remove("reveal", "is-in");
                  el.style.removeProperty("--d");
                };
                el.addEventListener("transitionend", done);
              });
            },
            { rootMargin: "0px 0px -8% 0px", threshold: 0.12 },
          );

          targets.forEach((el) => {
            if (!el || el.getBoundingClientRect().top < window.innerHeight) return;
            // Retard escalonat entre germans (màxim 4 passos)
            const index = Math.min(
              [...el.parentElement.children].filter((c) => targets.has(c)).indexOf(el),
              4,
            );
            if (index > 0) el.style.setProperty("--d", `${index * 90}ms`);
            el.classList.add("reveal");
            revealObserver.observe(el);
          });
        }

        // 7. LÓGICA DEL MENÚ MÓVIL
        const btnMenu = document.getElementById("mobile-menu-btn");
        const dropdownMenu = document.getElementById("mobile-dropdown");
        const mobileLinks = document.querySelectorAll(".mobile-link");

        if (btnMenu && dropdownMenu) {
          const setMenu = (open) => {
            dropdownMenu.classList.toggle("hidden", !open);
            dropdownMenu.classList.toggle("flex", open);
            btnMenu.setAttribute("aria-expanded", String(open));
          };

          btnMenu.addEventListener("click", (e) => {
            e.stopPropagation();
            setMenu(dropdownMenu.classList.contains("hidden"));
          });

          mobileLinks.forEach((link) => {
            link.addEventListener("click", () => setMenu(false));
          });

          // Tancar en tocar fora del menú o amb la tecla Escape
          document.addEventListener("click", (e) => {
            if (!dropdownMenu.contains(e.target)) setMenu(false);
          });
          document.addEventListener("keydown", (e) => {
            if (e.key === "Escape") setMenu(false);
          });
        }
      });
    </script>
  </body>
</html>
