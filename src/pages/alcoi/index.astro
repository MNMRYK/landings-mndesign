      content="#FAFAFC"
    />
    <meta
      name="theme-color"
      media="(prefers-color-scheme: dark)"
      content="#0F172A"
    />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />

    <link rel="canonical" href="https://mndesignweb.es/alcoi/" />
    <link rel="icon" type="image/webp" href="/favicon_v2.webp" />
    <meta name="robots" content="index, follow" />

    <meta
      name="description"
      content="Software a mida i automatització de processos per a empreses i indústries d'Alcoi, Cocentaina i comarques. Connectem comandes, producció, magatzem i facturació. També webs i botigues online."
    />
