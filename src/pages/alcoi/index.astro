              <div>
                <h4 class="font-extrabold text-base sm:text-lg mb-3">Cómo funciona la inversión</h4>
                <ul class="space-y-2 text-sm sm:text-base font-medium text-saas-muted">
                  {inversionAnuncios.map((x) => (
                    <li class="flex gap-2.5">
                      <Fragment set:html={icon(Check, "w-4 h-4 text-saas-iris-ink shrink-0 mt-1")} />
                      {x}
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- 7. SOFTWARE (color 2 de 3): fondo #1E1446 a todo el ancho, aurora detrás y contenido encima.
           El fondo va en .section-dark (iris.css), no en una clase de Tailwind. -->
      <section class="section-dark relative isolate text-white overflow-hidden">
        <div class="aurora aurora-dark" aria-hidden="true"></div>
        <div class="relative z-10 max-w-6xl mx-auto px-gutter">
