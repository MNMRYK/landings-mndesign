            <div class="rounded-[22px] overflow-hidden bg-white/70 border border-white">
              <div class="browser-bar" aria-hidden="true">
                <i></i><i></i><i></i>
                <span class="browser-url">mnmryk.github.io/demo-suministros</span>
              </div>
              <!-- Primera pantalla de la demo (1440×900, mismo 16:10 que el marco: no se desplaza) -->
              <div class="shot">
                <img
                  src="/alcoi/demos/suministros-hero-1440.webp"
                  srcset="/alcoi/demos/suministros-hero-720.webp 720w, /alcoi/demos/suministros-hero-1440.webp 1440w, /alcoi/demos/suministros-hero-2880.webp 2880w"
                  sizes="(min-width: 1024px) 1000px, 92vw"
                  width="1440"
                  height="900"
                  fetchpriority="high"
                  decoding="async"
                  alt="Demo de página web diseñada por MN Design Web: web de Norvia Suministros, almacén de material eléctrico, fontanería y suministro industrial"
                />
              </div>
            </div>
          </div>
          <!-- Avisos flotantes: ilustran funciones que integramos (decorativos). Colocados donde no tapan texto de la captura: abajo a la izquierda (zona vacía) y arriba a la derecha (sobre la foto) -->
