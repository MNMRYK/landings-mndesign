    <!-- Efectes lligats al scroll (scroll-driven animations, només CSS).
         Inline perquè el minificador no fusione animation-timeline dins d'animation. -->
    <style is:inline>
      /* 3. Efectes lligats al scroll: només CSS (scroll-driven animations).
         Els navegadors que no els suporten simplement no els mostren. */
      .scroll-progress {
        display: none;
      }
      @supports (animation-timeline: scroll()) {
        /* Barra de progrés de lectura sota el menú */
        .scroll-progress {
          display: block;
          position: absolute;
          left: 0;
          bottom: -1px;
          width: 100%;
          height: 3px;
          background: linear-gradient(90deg, #8b5cf6, #d946ef);
          transform-origin: 0 50%;
          animation: scroll-progress linear both;
          animation-timeline: scroll(root);
        }
        @keyframes scroll-progress {
          from { transform: scaleX(0); }
          to { transform: scaleX(1); }
        }

        /* Parallax suau dels brillants de fons del hero */
        .hero-glow {
          animation: hero-glow linear both;
          animation-timeline: scroll(root);
          animation-range: 0 700px;
        }
        @keyframes hero-glow {
          to { transform: translateY(160px); opacity: 0.35; }
        }

        /* El panell de l'ERP "s'endreça" mentre entra en pantalla */
        .hero-tilt {
          transform-origin: 50% 100%;
          animation: hero-tilt linear both;
          animation-timeline: view();
          animation-range: entry 0% cover 45%;
        }
        @keyframes hero-tilt {
          from { transform: perspective(1400px) rotateX(14deg) scale(0.94); }
          to { transform: none; }
        }
      }
      @media (prefers-reduced-motion: reduce) {
        .hero-glow,
        .hero-tilt,
        .scroll-progress {
          animation: none !important;
        }
      }
    </style>
  </head>
  <body
    class="text-slate-800 antialiased selection:bg-saas-violet selection:text-white"
  >
    <header
      class="fixed top-0 left-0 w-full z-[100] bg-white/95 backdrop-blur-xl border-b border-slate-200/80 shadow-sm"
    >
      <div
        class="max-w-7xl mx-auto px-6 h-20 flex items-center justify-between relative z-20 bg-transparent"
      >
        <a href="/" class="flex items-center gap-3 group shrink-0">
