---
import "./style.css";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Academia Online para Nutricionistas | MN Design Web</title>
    <meta
      name="theme-color"
      media="(prefers-color-scheme: light)"
      content="#080f1e"
    />
    <meta
      name="theme-color"
      media="(prefers-color-scheme: dark)"
      content="#080f1e"
    />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />

    <!-- URL CANÓNICA -->
    <link
      rel="canonical"
      href="https://descubre.mndesignweb.es/academia-nutricion"
    />
    <link rel="icon" type="image/webp" href="/favicon_v2.webp" />
    <meta name="robots" content="index, follow" />

    <!-- MEJORA WPO: Preconexión para acelerar carga de fuentes -->
    <!-- Sonner Toast Library -->
    <script src="https://cdn.jsdelivr.net/npm/sonner@1.7.1/dist/index.umd.js"
    ></script>
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/sonner@1.7.1/dist/styles.css"
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Montserrat:wght@700;800&family=Nunito:wght@400;600;700;800;900&display=swap"
      rel="stylesheet"
    />
    <link
      rel="preload"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
      as="style"
      onload="this.onload=null;this.rel='stylesheet'"
    />
    <noscript
      ><link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
      /></noscript
    >

    <!-- METADATOS PRINCIPALES -->
    <meta
      name="description"
      content="Escala tu facturación clínica sin sumar más horas. Creamos tu Academia Online a medida: cursos, membresías, protección de vídeos y cero comisiones por venta."
    />
    <meta name="author" content="MN Design Web" />

    <!-- OPEN GRAPH (Facebook, LinkedIn, WhatsApp) -->
    <meta property="og:type" content="website" />
    <meta
      property="og:url"
      content="https://descubre.mndesignweb.es/academia-nutricion"
    />
    <meta
      property="og:title"
      content="Academia Online para Nutricionistas | MN Design Web"
    />
    <meta
      property="og:description"
      content="Transforma tu conocimiento clínico en ingresos recurrentes. Plataformas e-learning a medida para el sector salud con pasarela de pagos integrada."
    />
    <meta
      property="og:image"
      content="https://descubre.mndesignweb.es/imagen-miniatura-academia.webp"
    />
    <meta property="og:locale" content="es_ES" />

    <!-- TWITTER CARDS (X) -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta
      name="twitter:url"
      content="https://descubre.mndesignweb.es/academia-nutricion"
    />
    <meta
      name="twitter:title"
      content="Academia Online para Nutricionistas | MN Design Web"
    />
    <meta
      name="twitter:description"
      content="Transforma tu conocimiento clínico en ingresos recurrentes. Plataformas e-learning a medida para el sector salud con pasarela de pagos integrada."
    />
    <meta
      name="twitter:image"
      content="https://descubre.mndesignweb.es/imagen-miniatura-academia.webp"
    />

    <!-- DATOS ESTRUCTURADOS (JSON-LD) -->
    <script type="application/ld+json">
      [
        {
          "@context": "https://schema.org",
          "@type": "WebPage",
          "name": "Desarrollo de Academias Online para Nutrición | MN Design Web",
          "description": "Desarrollo de plataformas e-learning personalizadas para nutricionistas y profesionales de la salud. Vende cursos y membresías sin comisiones de terceros."
        },
        {
          "@context": "https://schema.org",
          "@type": "ProfessionalService",
          "name": "MN Design Web",
          "image": "https://descubre.mndesignweb.es/logo.webp",
          "url": "https://descubre.mndesignweb.es/",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Alicante",
            "addressCountry": "ES"
          },
          "priceRange": "$$"
        },
        {
          "@context": "https://schema.org/",
          "@type": "Service",
          "name": "Creación de Academias Digitales y E-commerce de Formación",
          "image": "https://descubre.mndesignweb.es/imagen-miniatura-academia.webp",
          "description": "Sistemas LMS a medida con pasarelas de pago (Stripe/Mercado Pago), protección de contenidos audiovisuales y foros privados para alumnos."
        },
        {
          "@context": "https://schema.org",
          "@type": "FAQPage",
          "mainEntity": [
            {
              "@type": "Question",
              "name": "¿Me cobráis comisiones por cada curso o membresía que venda?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "No. Al ser un desarrollo a medida, la plataforma es 100% tuya. Todo lo que factures va directo a tu cuenta sin los peajes abusivos de plataformas de terceros."
              }
            },
            {
              "@type": "Question",
              "name": "¿Están protegidos mis vídeos y PDFs para que no los descarguen?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Sí, implementamos protocolos de seguridad y reproductores encriptados para dificultar la piratería y proteger tu capital intelectual clínico."
              }
            },
            {
              "@type": "Question",
              "name": "¿Pueden los alumnos interactuar o preguntar dudas?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Desarrollamos sistemas de foros privados y cajas de comentarios por lección para que puedas moderar y fidelizar a tu propia comunidad sin depender de redes sociales."
              }
            },
            {
              "@type": "Question",
              "name": "¿Se encarga MN Design Web del mantenimiento técnico?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Tú solo te encargas de grabar y subir el contenido. Nosotros garantizamos las actualizaciones de seguridad, el servidor y el correcto funcionamiento de los pagos."
              }
            },
            {
              "@type": "Question",
              "name": "¿Qué hago si todavía no tengo página web de captación?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Ofrecemos un pack de 'Despegue Digital' que incluye el diseño de tu Landing Page optimizada para vender tu programa, además de configurar todo el hosting y dominio."
              }
            }
          ]
        },
        {
          "@context": "https://schema.org",
          "@type": "BreadcrumbList",
          "itemListElement": [
            {
              "@type": "ListItem",
              "position": 1,
              "name": "Inicio MN Design Web",
              "item": "https://mndesignweb.es/"
            },
            {
              "@type": "ListItem",
              "position": 2,
              "name": "Academia Online para Nutricionistas",
              "item": "https://descubre.mndesignweb.es/academia-nutricion"
            }
          ]
        }
      ]
    </script>

