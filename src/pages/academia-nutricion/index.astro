    <p class="cookieHeading">Usamos cookies</p>
    <p class="cookieDescription">
      Utilizamos cookies para darte la mejor experiencia en nuestra web. <br />
      <a class="cookielink" href="https://mndesignweb.es/cookies"
        >Ver políticas de cookies</a
      >
    </p>
    <div class="buttonContainer">
      <button id="btn-accept-cookies" class="acceptButton">Permitir</button>
      <button id="btn-decline-cookies" class="declineButton">Rechazar</button>
    </div>
  </div>

  <script is:inline>
    // ==========================================
    // 0. FUNCIÓN TOAST NATIVA (Infalible)
    // ==========================================
    function mostrarToast(titulo, descripcion, tipo = "success") {
      let container = document.getElementById("custom-toast-container");
      if (!container) {
        container = document.createElement("div");
        container.id = "custom-toast-container";
        document.body.appendChild(container);
      }

      const toast = document.createElement("div");
      toast.className = `custom-toast ${tipo}`;

      const icono =
        tipo === "success"
          ? '<i class="fa-solid fa-circle-check" style="color: #16a34a; font-size: 1.2rem; margin-top: 2px;"></i>'
          : '<i class="fa-solid fa-circle-exclamation" style="color: #dc2626; font-size: 1.2rem; margin-top: 2px;"></i>';

      toast.innerHTML = `
        ${icono}
        <div class="custom-toast-content">
          <strong>${titulo}</strong>
          <span>${descripcion}</span>
        </div>
      `;
      container.appendChild(toast);

      setTimeout(() => {
        toast.remove();
      }, 5000);
    }

    // ==========================================
    // 1. LÓGICA DESCARGA DOSSIER
    // ==========================================
    const formDossier = document.getElementById("dossier-form");
    if (formDossier) {
      formDossier.addEventListener("submit", function (e) {
        e.preventDefault();
        const btn = document.getElementById("btn-dossier");
        btn.innerHTML =
          'Procesando... <i class="fa-solid fa-spinner fa-spin"></i>';
        btn.disabled = true;

        const data = {
          access_key: "1bc2d285-71cb-4fe3-806f-530066ab6e15",
          subject: "Lead Magnet: Descarga Dossier Academias",
          nombre: document.getElementById("dossier-nombre").value,
          email: document.getElementById("dossier-email").value,
        };

        Promise.all([
          fetch("https://api.web3forms.com/submit", {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
              Accept: "application/json",
            },
            body: JSON.stringify(data),
          }),
          fetch("https://hook.eu1.make.com/mxvqg7gwne43yab165v2uhtyw5yh115r", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(data),
          }),
        ])
          .then(async (results) => {
            const result = await results[0].json();
            if (result.success) {
              if (typeof gtag === "function")
                gtag("event", "download_dossier", {
                  currency: "EUR",
                  value: 0,
                });
              if (typeof fbq === "function") fbq("track", "Lead");
              if (typeof clarity === "function")
                clarity("set", "lead", "dossier_academia");

              mostrarToast(
                "¡Dossier en camino!",
                "La descarga comenzará automáticamente.",
              );

              const link = document.createElement("a");
              link.href = "/dossier-academia.pdf";
              link.download = "Dossier_Academia_MNDesignWeb.pdf";
              document.body.appendChild(link);
              link.click();
              document.body.removeChild(link);

              formDossier.reset();
            } else {
              throw new Error("Error en el envío");
            }
          })
          .catch(() =>
            mostrarToast(
              "Vaya, algo ha fallado",
              "Hubo un error al procesar tu solicitud. Inténtalo de nuevo.",
              "error",
            ),
          )
          .finally(() => {
            btn.innerHTML =
              'Descargar Dossier Ahora <i class="fa-solid fa-download"></i>';
            btn.disabled = false;
          });
      });
    }

    // ==========================================
    // 2. LÓGICA FORMULARIO CONTACTO / AUDITORÍA
    // ==========================================
    window.addEventListener("DOMContentLoaded", () => {
      const formAcademias = document.getElementById("formulario");
      if (formAcademias) {
        formAcademias.addEventListener("submit", function (e) {
          e.preventDefault();
          const btn = document.getElementById("btn-submit");
          btn.innerHTML =
            'Enviando... <i class="fa-solid fa-spinner fa-spin"></i>';
          btn.disabled = true;

          const data = {
            access_key: "1bc2d285-71cb-4fe3-806f-530066ab6e15",
            subject: "Nuevo Lead: Academias de Nutrición",
            nombre: document.getElementById("nombre").value,
            email: document.getElementById("email").value,
            telefono: document.getElementById("telefono").value,
            mensaje: document.getElementById("mensaje").value,
          };

          Promise.all([
            fetch("https://api.web3forms.com/submit", {
              method: "POST",
              headers: {
                "Content-Type": "application/json",
                Accept: "application/json",
              },
              body: JSON.stringify(data),
            }),
            fetch(
              "https://hook.eu1.make.com/mxvqg7gwne43yab165v2uhtyw5yh115r",
              {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify(data),
              },
            ),
          ])
            .then(async (results) => {
              const result = await results[0].json();
              if (result.success) {
                if (typeof gtag === "function")
                  gtag("event", "generate_lead", { currency: "EUR", value: 0 });
                if (typeof fbq === "function") fbq("track", "Lead");
                if (typeof clarity === "function")
                  clarity("set", "lead", "academia_nutricion");

                mostrarToast(
                  "¡Solicitud recibida con éxito!",
                  "Analizaré tu caso personalmente y te responderé muy pronto.",
                );
                formAcademias.reset();
              } else {
                throw new Error("Error en el envío");
              }
            })
            .catch(() =>
              mostrarToast(
                "Error de envío",
                "No se ha podido enviar el mensaje. Por favor, revísalo.",
                "error",
              ),
            )
            .finally(() => {
              btn.innerHTML =
                'Enviar solicitud de auditoría <i class="fa-solid fa-paper-plane"></i>';
              btn.disabled = false;
            });
        });
      }

      // ==========================================
      // 3. BANNER DE COOKIES
      // ==========================================
      const cookieBanner = document.getElementById("cookie-banner");
      const acceptBtn = document.getElementById("btn-accept-cookies");
      const declineBtn = document.getElementById("btn-decline-cookies");
      const consent = localStorage.getItem("cookieConsent");

      if (!consent && cookieBanner) {
        cookieBanner.style.display = "flex";
      }

      if (acceptBtn) {
        acceptBtn.addEventListener("click", () => {
          localStorage.setItem("cookieConsent", "accepted");
          cookieBanner.style.display = "none";
          if (typeof gtag === "function")
            gtag("consent", "update", {
              ad_storage: "granted",
              ad_user_data: "granted",
              ad_personalization: "granted",
              analytics_storage: "granted",
            });
          if (typeof clarity === "function") clarity("consent");
          if (typeof fbq === "function") fbq("consent", "grant");
        });
      }

      if (declineBtn) {
        declineBtn.addEventListener("click", () => {
          localStorage.setItem("cookieConsent", "declined");
          cookieBanner.style.display = "none";
          if (typeof gtag === "function")
            gtag("consent", "update", {
              ad_storage: "denied",
              ad_user_data: "denied",
              ad_personalization: "denied",
              analytics_storage: "denied",
            });
        });
      }
    });
  </script>
