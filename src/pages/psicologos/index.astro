    <!-- ===== ARCHIVO JS ===== -->
    <script is:inline>
      (function () {
        var reduce = window.matchMedia(
          "(prefers-reduced-motion: reduce)",
        ).matches;

        /* JS-1 · Revelado al hacer scroll */
        var rv = document.querySelectorAll(".rv");
        if ("IntersectionObserver" in window && !reduce) {
          var io = new IntersectionObserver(
            function (entries) {
              entries.forEach(function (e) {
                if (e.isIntersecting) {
                  e.target.classList.add("in");
                  io.unobserve(e.target);
                }
              });
            },
            { rootMargin: "0px 0px -8% 0px", threshold: 0.12 },
          );
          rv.forEach(function (el) {
            io.observe(el);
          });
        } else {
          rv.forEach(function (el) {
            el.classList.add("in");
          });
        }

        /* JS-MENU · Menú hamburguesa (tablet/móvil) */
        var header = document.getElementById("top");
        var burger = document.getElementById("burger");
        var mnav = document.getElementById("mnav");
        var mclose = document.getElementById("mnav-close");
        if (header && burger && mnav) {
          var setMenu = function (open, restoreFocus) {
            header.classList.toggle("open", open);
            document.documentElement.classList.toggle("menu-open", open);
            burger.setAttribute("aria-expanded", open ? "true" : "false");
            burger.setAttribute(
              "aria-label",
              open ? "Cerrar menú" : "Abrir menú",
            );
            if (open) {
              var first = mnav.querySelector(".mnav-links a");
              if (first)
                setTimeout(function () {
                  first.focus({ preventScroll: true });
                }, 60);
            } else if (restoreFocus) {
              burger.focus();
            }
          };
          burger.addEventListener("click", function () {
            setMenu(!header.classList.contains("open"));
          });
          // Al pulsar un enlace se cierra el menú y el navegador baja a la sección
          mnav.querySelectorAll("a").forEach(function (a) {
            a.addEventListener("click", function () {
              setMenu(false);
            });
          });
          if (mclose)
            mclose.addEventListener("click", function () {
              setMenu(false, true);
            });
          document.addEventListener("keydown", function (e) {
            if (e.key === "Escape" && header.classList.contains("open"))
              setMenu(false, true);
          });
          // Si se amplía la ventana a escritorio con el menú abierto, se cierra
          window
            .matchMedia("(min-width: 901px)")
            .addEventListener("change", function (e) {
              if (e.matches) setMenu(false);
            });
        }

        /* JS-2 · Foco de luz que sigue al cursor en las tarjetas */
        document.querySelectorAll("[data-spot]").forEach(function (el) {
          el.addEventListener("pointermove", function (e) {
            var r = el.getBoundingClientRect();
            el.style.setProperty("--mx", e.clientX - r.left + "px");
            el.style.setProperty("--my", e.clientY - r.top + "px");
          });
        });

        /* JS-3 · Parallax 3D suave de los móviles del hero */
        var trio = document.getElementById("trio");
        if (trio && !reduce && window.matchMedia("(pointer: fine)").matches) {
          var stage = trio.parentElement;
          stage.addEventListener("pointermove", function (e) {
            var r = stage.getBoundingClientRect();
            var x = (e.clientX - r.left) / r.width - 0.5;
            var y = (e.clientY - r.top) / r.height - 0.5;
            trio.style.transform =
              "rotateY(" + x * 8 + "deg) rotateX(" + -y * 6 + "deg)";
          });
          stage.addEventListener("pointerleave", function () {
            trio.style.transform = "";
          });
        }

        /* JS-4 · Timeline: rellena la línea, activa nodos y marca el paso actual */
        var tl = document.getElementById("tl");
        var now = document.getElementById("tl-now");
        var top = document.getElementById("top");
        var sticky = document.getElementById("sticky-cta");
        var items = tl ? [].slice.call(tl.querySelectorAll(".tl-item")) : [];
        var ticking = false;
        function update() {
          var mark = window.innerHeight * 0.6;
          if (tl) {
            var r = tl.getBoundingClientRect();
            tl.style.setProperty(
              "--p",
              Math.min(1, Math.max(0, (mark - r.top) / r.height)),
            );
            var cur = -1;
            items.forEach(function (it, i) {
              var on = it.getBoundingClientRect().top < mark;
              it.classList.toggle("on", on);
              if (on) cur = i;
            });
            items.forEach(function (it, i) {
              it.classList.toggle("current", i === cur);
            });
            if (now) now.textContent = Math.max(1, cur + 1);
          }
          if (top) top.classList.toggle("scrolled", window.scrollY > 20);
          if (sticky)
            sticky.classList.toggle(
              "show",
              window.scrollY > window.innerHeight * 0.7,
            );
          ticking = false;
        }
        function req() {
          if (!ticking) {
            ticking = true;
            requestAnimationFrame(update);
          }
        }
        window.addEventListener("scroll", req, { passive: true });
        window.addEventListener("resize", req);
        update();

        /* Pulsar un paso despliega "Qué recibes" */
        items.forEach(function (it) {
          var btn = it.querySelector(".tl-card");
          btn.addEventListener("click", function () {
            btn.setAttribute(
              "aria-expanded",
              btn.getAttribute("aria-expanded") === "true" ? "false" : "true",
            );
          });
        });

        /* JS-5 · Envío del formulario de contacto */
        var formClinica = document.getElementById("formulario");
        if (formClinica) {
          formClinica.addEventListener("submit", function (e) {
            e.preventDefault();
            var btn = document.getElementById("btn-submit");
            var originalText = btn.innerHTML; // Guardamos el texto original con el icono SVG
            btn.innerText = "Enviando...";
            btn.disabled = true;

            var data = {
              access_key: "1bc2d285-71cb-4fe3-806f-530066ab6e15",
              subject: "Nuevo Lead: Psicólogos / Clínicas",
              nombre: document.getElementById("nombre").value,
              email: document.getElementById("email").value,
              telefono: document.getElementById("telefono").value,
              servicio: document.getElementById("servicio").value,
              mensaje: document.getElementById("mensaje").value,
              privacidad: "Aceptada",
            };

            Promise.all([
              fetch("https://api.web3forms.com/submit", {
                method: "POST",
                headers: {
                  "Content-Type": "application/json",
                  Accept: "application/json",
                },
                body: JSON.stringify(data),
              }),
              fetch(
                "https://hook.eu1.make.com/mxvqg7gwne43yab165v2uhtyw5yh115r",
                {
                  method: "POST",
                  headers: { "Content-Type": "application/json" },
                  body: JSON.stringify(data),
                },
              ),
            ])
              .then(async (results) => {
                const result = await results[0].json();
                if (result.success) {
                  if (typeof gtag === "function")
                    gtag("event", "generate_lead", {
                      currency: "EUR",
                      value: 0,
                    });
                  if (typeof fbq === "function") fbq("track", "Lead");
                  if (typeof clarity === "function")
                    clarity("set", "lead", "clinica");

                  document.getElementById("ok-msg").style.display = "block";
                  formClinica.reset();
                } else {
                  throw new Error("Error en el envío");
                }
              })
              .catch(() => {
                alert("Hubo un error. Por favor, inténtalo de nuevo.");
              })
              .finally(() => {
                btn.innerHTML = originalText;
                btn.disabled = false;
              });
          });
        }
      })();

      /* JS-5b · Checklist RGPD: capta el email y muestra el enlace de descarga */
      (function () {
        var formCheck = document.getElementById("form-checklist");
        if (!formCheck) return;
        formCheck.addEventListener("submit", function (e) {
          e.preventDefault();
          var btn = document.getElementById("btn-checklist");
          var originalText = btn.innerHTML;
          btn.innerText = "Enviando...";
          btn.disabled = true;

          var data = {
            access_key: "1bc2d285-71cb-4fe3-806f-530066ab6e15",
            subject: "Nuevo Lead: Checklist RGPD Psicólogos",
            email: document.getElementById("email-checklist").value,
            origen: "checklist-rgpd",
            privacidad: "Aceptada",
          };

          fetch("https://api.web3forms.com/submit", {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
              Accept: "application/json",
            },
            body: JSON.stringify(data),
          })
            .then(function (r) {
              return r.json();
            })
            .then(function (result) {
              if (!result.success) throw new Error("Error en el envío");
              // Copia a Make sin bloquear la descarga si falla
              fetch("https://hook.eu1.make.com/mxvqg7gwne43yab165v2uhtyw5yh115r", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify(data),
              }).catch(function () {});

              if (typeof gtag === "function")
                gtag("event", "download_checklist", { method: "checklist_rgpd" });
              if (typeof fbq === "function") fbq("track", "Lead", { content_name: "Checklist RGPD" });

              document.getElementById("ok-checklist").style.display = "block";
              formCheck.reset();
            })
            .catch(function () {
              alert("Hubo un error. Por favor, inténtalo de nuevo.");
            })
            .finally(function () {
              btn.innerHTML = originalText;
              btn.disabled = false;
            });
        });
      })();

      /* JS-7 · Calendario de Cal.com (embed oficial) + medición de reservas.
         Se carga al acercarse a la sección de contacto para no frenar la carga inicial. */
      (function () {
        var box = document.getElementById("cal-inline");
        if (!box) return;
        var loaded = false;

        function loadCal() {
          if (loaded) return;
          loaded = true;
          (function (C, A, L) {
            var p = function (a, ar) { a.q.push(ar); };
            var d = C.document;
            C.Cal = C.Cal || function () {
              var cal = C.Cal;
              var ar = arguments;
              if (!cal.loaded) {
                cal.ns = {};
                cal.q = cal.q || [];
                d.head.appendChild(d.createElement("script")).src = A;
                cal.loaded = true;
              }
              if (ar[0] === L) {
                var api = function () { p(api, arguments); };
                var namespace = ar[1];
                api.q = api.q || [];
                if (typeof namespace === "string") {
                  cal.ns[namespace] = cal.ns[namespace] || api;
                  p(cal.ns[namespace], ar);
                  p(cal, ["initNamespace", namespace]);
                } else p(cal, ar);
                return;
              }
              p(cal, ar);
            };
          })(window, "https://app.cal.com/embed/embed.js", "init");

          Cal("init", "llamada", { origin: "https://cal.com" });
          Cal.ns.llamada("inline", {
            elementOrSelector: "#cal-inline",
            calLink: "mndesignweb/reunion-30-min",
            config: { layout: "month_view" },
          });
          Cal.ns.llamada("ui", { hideEventTypeDetails: false, layout: "month_view" });

          // Conversión principal: reserva completada. Cal.com emite el evento
          // antiguo y el V2; escuchamos los dos y solo contamos una vez.
          var booked = false;
          function onBooked() {
            if (booked) return;
            booked = true;
            if (typeof gtag === "function")
              gtag("event", "book_call", { method: "cal_com" });
            if (typeof fbq === "function") fbq("track", "Schedule");
            if (typeof clarity === "function") clarity("set", "lead", "llamada");
          }
          Cal.ns.llamada("on", { action: "bookingSuccessfulV2", callback: onBooked });
          Cal.ns.llamada("on", { action: "bookingSuccessful", callback: onBooked });
        }

        if ("IntersectionObserver" in window) {
          var io = new IntersectionObserver(
            function (entries) {
              if (entries[0].isIntersecting) {
                loadCal();
                io.disconnect();
              }
            },
            { rootMargin: "800px 0px" },
          );
          io.observe(box);
        } else {
          loadCal();
        }
      })();

      /* JS-8 · Medición de clics en teléfono, WhatsApp y email */
      document.addEventListener("click", function (e) {
        var a = e.target.closest && e.target.closest("a[href]");
        if (!a) return;
        var href = a.getAttribute("href");
        var tipo = null;
        if (href.indexOf("tel:") === 0) tipo = "phone";
        else if (href.indexOf("wa.me") !== -1 || href.indexOf("whatsapp") !== -1) tipo = "whatsapp";
        else if (href.indexOf("mailto:") === 0) tipo = "email";
        if (!tipo) return;
        if (typeof gtag === "function")
          gtag("event", "click_" + tipo, { link_url: href });
        if (typeof fbq === "function") fbq("track", "Contact", { content_name: tipo });
      });

      /* JS-6 · Lógica del banner de cookies */
      window.addEventListener("DOMContentLoaded", () => {
        const cookieBanner = document.getElementById("cookie-banner");
        const acceptBtn = document.getElementById("btn-accept-cookies");
        const declineBtn = document.getElementById("btn-decline-cookies");

        const consent = localStorage.getItem("cookie_consent");

        if (!consent && cookieBanner) {
          cookieBanner.style.display = "flex";
        }

        if (acceptBtn) {
          acceptBtn.addEventListener("click", () => {
            localStorage.setItem("cookie_consent", "accepted");
            cookieBanner.style.display = "none";

            if (typeof gtag === "function") {
              gtag("consent", "update", {
                ad_storage: "granted",
                ad_user_data: "granted",
                ad_personalization: "granted",
                analytics_storage: "granted",
              });
            }

            if (typeof clarity === "undefined") {
              (function (c, l, a, r, i, t, y) {
                c[a] =
                  c[a] ||
                  function () {
                    (c[a].q = c[a].q || []).push(arguments);
                  };
                t = l.createElement(r);
                t.async = 1;
                t.src = "https://www.clarity.ms/tag/" + i;
                y = l.getElementsByTagName(r)[0];
                y.parentNode.insertBefore(t, y);
              })(window, document, "clarity", "script", "wuzaxaifa0");
            }
            // Clarity exige la señal de consentimiento en la UE para usar cookies
            clarity("consent");

            if (typeof fbq === "function") fbq("consent", "grant");
          });
        }

        if (declineBtn) {
          declineBtn.addEventListener("click", () => {
            localStorage.setItem("cookie_consent", "declined");
            cookieBanner.style.display = "none";

            if (typeof gtag === "function") {
              gtag("consent", "update", {
                ad_storage: "denied",
                ad_user_data: "denied",
                ad_personalization: "denied",
                analytics_storage: "denied",
              });
            }
          });
        }
      });
    </script>
