              </li>
            </ul>

            
            <div class="bento-visual">
              <img
                src="/historial.webp"
                alt="Gestión Clínica Legal"
                class="bento-img"
              />
            </div>
          </div>

          
          <div class="bento-card bento-large">
            <div class="bento-icon">
              <svg
                xmlns="http://www.w3.org/2000/svg"
