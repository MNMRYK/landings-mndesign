    <script type="application/ld+json">
      [
        {
          "@context": "https://schema.org",
          "@type": "WebPage",
          "name": "Portal Salud - Software de Gestión para Clínicas | MN Design Web",
          "description": "Desarrollo y software de gestión clínica en propiedad con pago único. Portal del paciente y academia para el sector salud."
        },
        {
          "@context": "https://schema.org",
          "@type": "SoftwareApplication",
          "name": "Portal Salud Consultas",
          "operatingSystem": "All",
          "applicationCategory": "BusinessApplication",
          "description": "Software integral para la gestión de clínicas con inversión inicial de pago único.",
          "offers": [
            {
              "@type": "Offer",
              "name": "Primera Presencia",
              "price": "790",
              "priceCurrency": "EUR",
              "description": "Pago único"
            },
            {
              "@type": "Offer",
              "name": "Portal Paciente",
              "price": "1350",
              "priceCurrency": "EUR",
              "description": "Pago único"
            },
            {
              "@type": "Offer",
              "name": "Portal + Academia",
              "price": "2190",
              "priceCurrency": "EUR",
              "description": "Pago único"
            }
          ]
        },
        {
          "@context": "https://schema.org",
          "@type": "ProfessionalService",
          "name": "MN Design Web",
          "image": "https://mndesignweb.es/logo.webp",
          "url": "https://mndesignweb.es/",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Alicante",
            "addressCountry": "ES"
          },
          "priceRange": "€€"
        },
        {
          "@context": "https://schema.org",
          "@type": "FAQPage",
          "mainEntity": [
            {
              "@type": "Question",
              "name": "¿Cómo se realiza el pago del software y la web?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Funciona mediante una inversión inicial de pago único según el plan elegido (Primera Presencia, Portal Paciente o Portal + Academia). No existen cuotas mensuales de software, tan solo un mantenimiento opcional si se requiere activo."
              }
            },
            {
              "@type": "Question",
              "name": "¿Cómo migro los datos de mi clínica actual?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Ofrecemos herramientas de importación masiva mediante CSV o Excel. Nuestro equipo de soporte se encarga de realizar la migración por ti sin coste adicional en los planes avanzados."
              }
            },
            {
              "@type": "Question",
              "name": "¿Cumplen con las normativas de protección de datos?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Sí, Portal Salud cumple con GDPR y las normativas sanitarias europeas. La información está encriptada de extremo a extremo con estrictos protocolos de seguridad."
              }
            },
            {
              "@type": "Question",
              "name": "¿Puedo integrar Portal Salud con otras aplicaciones?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Sí, contamos con integraciones nativas para calendarios, pasarelas de pago como Stripe, herramientas de videoconsulta y conexión con tu ERP."
              }
            }
          ]
        },
        {
          "@context": "https://schema.org",
          "@type": "BreadcrumbList",
          "itemListElement": [
            {
              "@type": "ListItem",
              "position": 1,
              "name": "Inicio MN Design Web",
              "item": "https://mndesignweb.es/"
            },
            {
              "@type": "ListItem",
              "position": 2,
              "name": "Portal Salud - Software para Clínicas",
              "item": "https://mndesignweb.es/clinicas/"
            }
          ]
        }
      ]
    </script>

