              >
                Facturación del mes
              </div>
              <div
                style="font-size: 1.5rem; font-weight: 700; margin-bottom: 12px;"
              >
                18.450 €
              </div>
              <div
                style="display: flex; gap: 4px; align-items: flex-end; height: 60px;"
              >
                <div
                  style="background: var(--border-color); width: 20%; height: 40%; border-radius: 4px;"
                >
                </div>
                <div
                  style="background: var(--border-color); width: 20%; height: 60%; border-radius: 4px;"
                >
                </div>
                <div
                  style="background: var(--accent-blue); width: 20%; height: 100%; border-radius: 4px;"
                >
                </div>
                <div
                  style="background: var(--border-color); width: 20%; height: 80%; border-radius: 4px;"
                >
                </div>
                <div
                  style="background: var(--border-color); width: 20%; height: 50%; border-radius: 4px;"
                >
                </div>
              </div>
            </div>

            
            <img
              src="/vista-paciente.webp"
              alt="Portal del paciente de Portal Salud en una tablet: tareas, consentimientos y diario de síntomas"
              width="1400"
              height="937"
              fetchpriority="high"
              class="mockup-main-image"
            />
          </div>
        </section>
      </div>

      <!-- Franja de integraciones: lo que ya usa la clínica (no tecnologías internas) -->
      <section class="tech-stack reveal">
        <div class="container">
          <p class="tech-title">
            Se conecta con las herramientas que ya usa tu clínica
          </p>

          <div class="marquee-container">
            {[integrations, capabilities].map((list, i) => (
              <div class={`marquee-track ${i === 0 ? "track-left" : "track-right"}`}>
                {list.map((t) => <div class="tech-tag">{t}</div>)}
                {list.map((t) => <div class="tech-tag" aria-hidden="true">{t}</div>)}
              </div>
            ))}
          </div>
        </div>
      </section>

      <section id="funciones" class="features container reveal">
