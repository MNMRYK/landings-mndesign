    <style>
      :root {
        --shopify-green: #008060;
        --dark-green: #004c3f;
        --bg-light: #f4f6f8;
        --text-dark: #212326;
        --text-light: #6b7177;
        --white: #ffffff;
        --accent-hover: #005c45;
        --border-color: #dfe3e8;
        --shadow-sm: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
        --shadow-lg: 0 10px 25px -5px rgba(0, 0, 0, 0.15);
        --radius: 12px;
        --transition: all 0.3s ease;
      }

      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
        /* Soporte para Firefox (barra fina) */
        scrollbar-width: thin;
        scrollbar-color: #0055406e #f4f6f800;
      }
      /* 2. Personalización de la barra de desplazamiento (Scrollbar) con colores de Shopify */
      ::-webkit-scrollbar {
        width: 10px; /* Ancho de la barra */
      }

      body {
        font-family: "Inter", system-ui, sans-serif;
        background-color: var(--bg-light);
        color: var(--text-dark);
        line-height: 1.6;
      }

      .container {
        max-width: 1350px;
        margin: 0 auto;
        padding: 0 24px;
      }

      .section-title {
        text-align: center;
        font-size: 2.5rem;
        margin-bottom: 3rem;
        font-weight: 800;
        color: var(--dark-green);
      }

      /* BOTONES */
      .btn {
        display: inline-block;
        text-align: center;
        border-radius: 8px;
        font-weight: 700;
        cursor: pointer;
        transition: var(--transition);
        text-decoration: none;
        border: none;
      }

      .btn-primary {
        background-color: var(--shopify-green);
        color: var(--white);
        padding: 16px 32px;
        font-size: 1.1rem;
        box-shadow: var(--shadow-sm);
      }
      .btn-primary:hover {
        background-color: var(--accent-hover);
        transform: translateY(-2px);
      }

      .btn-dark {
        background-color: var(--dark-green);
        color: var(--white);
        padding: 14px 24px;
      }

      .btn-large {
        font-size: 1.25rem;
        padding: 20px 40px;
      }
      .btn-giant {
        width: 100%;
        padding: 18px;
        font-size: 1.2rem;
        margin-top: 1rem;
      }

      /* 1. HERO */
      .hero {
        background: linear-gradient(
          135deg,
          #002e26 0%,
          var(--dark-green) 50%,
          var(--shopify-green) 100%
        );
        color: var(--white);
        min-height: 100vh;
        display: flex;
        align-items: center;
        position: relative;
        overflow: hidden;
      }

      .top-nav {
        position: absolute;
        top: 0;
        left: 50%;
        transform: translateX(-50%);
        width: 100%;
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding-top: 2rem;
        z-index: 10;
      }

      .texto-logo {
        display: flex;
        align-items: baseline;
        gap: 6px;
        color: var(--white);
        flex: 1;
        text-decoration: none;
      }
      .texto-logo .siglas {
        font-size: 1.8rem;
        font-weight: 900;
        letter-spacing: -1px;
      }
      .texto-logo .marca {
        font-size: 1.2rem;
        font-weight: 400;
        opacity: 0.9;
      }

      .custom-shopify-logo {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        flex: 1;
      }
      .shopify-bag {
        width: 45px;
        height: auto;
      }
      .shopify-text {
        color: var(--white);
        font-size: 1.5rem;
        font-weight: 700;
        letter-spacing: -0.5px;
      }
      .nav-spacer {
        flex: 1;
      }

      .hero-content {
        display: grid;
        grid-template-columns: 1.2fr 0.8fr;
        gap: 2rem;
        align-items: center;
        width: 100%;
        padding-top: 6rem;
        padding-bottom: 2rem;
      }

      .hero-text {
        text-align: left;
      }
      .hero h1 {
        font-size: 3.5rem;
        line-height: 1.1;
        margin-bottom: 1.5rem;
        font-weight: 800;
      }
      .hero .highlight {
        color: #5cffc9;
      }
      .hero .subtitle {
        font-size: 1.25rem;
        max-width: 600px;
        margin: 0 0 2.5rem 0;
        opacity: 0.9;
      }

      .trust-badges {
        display: flex;
        justify-content: flex-start;
        gap: 2rem;
        margin-top: 3rem;
        flex-wrap: wrap;
      }
      .trust-item {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 0.9rem;
        color: #aee9d1;
      }
      .trust-item svg {
        width: 20px;
        height: 20px;
      }

      .hero-image {
        display: flex;
        justify-content: center;
        align-items: center;
      }
      .hero-image img {
        width: 100%;
        max-width: 450px;
        height: auto;
        filter: drop-shadow(0 20px 30px rgba(0, 0, 0, 0.4));
      }

      /* 2. GLASS BENTO GRID */
      .pain-points {
        padding: 7rem 0;
        background-color: var(--bg-light);
        position: relative;
        overflow: hidden;
      }
      .blob {
        position: absolute;
        border-radius: 50%;
        filter: blur(80px);
        z-index: 0;
        opacity: 0.6;
      }
      .blob-1 {
        top: -10%;
        left: -5%;
        width: 400px;
        height: 400px;
        background-color: rgba(92, 255, 201, 0.4);
      }
      .blob-2 {
        bottom: 10%;
        right: -5%;
        width: 500px;
        height: 500px;
        background-color: rgba(0, 128, 96, 0.2);
      }
      .pain-points .container {
        position: relative;
        z-index: 1;
      }

      .glass-bento-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        grid-auto-rows: minmax(220px, auto);
        gap: 1.5rem;
      }
      .glass-card {
        background: rgba(255, 255, 255, 0.6);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border: 1px solid rgba(255, 255, 255, 0.8);
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.03);
        border-radius: 20px;
        padding: 2rem;
        display: flex;
        flex-direction: column;
        justify-content: flex-start;
        transition: all 0.4s ease;
      }
      .glass-card:hover {
        transform: translateY(-5px);
        background: rgba(255, 255, 255, 0.9);
        box-shadow: 0 15px 35px rgba(0, 128, 96, 0.08);
        border: 1px solid var(--shopify-green);
      }

      .glass-icon {
        width: 48px;
        height: 48px;
        background: var(--dark-green);
        color: var(--white);
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 1.2rem;
      }
      .glass-icon svg {
        width: 24px;
        height: 24px;
      }
      .glass-card h3 {
        font-size: 1.25rem;
        margin-bottom: 0.7rem;
        color: var(--dark-green);
      }
      .glass-card p {
        color: var(--text-light);
        font-size: 0.95rem;
        line-height: 1.5;
        margin: 0;
      }

      .visual-card {
        grid-column: span 2;
        grid-row: span 2;
        background: linear-gradient(
          135deg,
          rgba(255, 255, 255, 0.9),
          rgba(244, 246, 248, 0.7)
        );
        justify-content: space-between;
        padding: 0;
        overflow: hidden;
      }
      .floating-bag {
        width: 100%;
        max-width: 320px;
        margin: 2rem auto 0;
        display: block;
        animation: float-soft 6s ease-in-out infinite;
      }
